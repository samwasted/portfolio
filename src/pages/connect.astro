---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShaderBackground from '../components/ShaderBackground.astro';
import Nav from '../components/Nav.astro';
import ContactComponent from '../components/Contact.astro';

// Import Astro's native Image optimization component
import { Image } from 'astro:assets';

// Import the background images
import bgImage from '../../public/hands.png';
import bgImage2 from '../../public/handss.png';
import bgImage3 from '../../public/residue.png';
---

<BaseLayout title="Connect - Samarpan Verma" bodyClass="no-scroll">
  <ShaderBackground />
  
  <!-- Master Animation Group (Isolates the dimming effect so it doesn't darken the page background) -->
  <div class="master-animation-group fixed z-0 pointer-events-none mix-blend-screen isolate">
    <!-- Base Hands Image -->
    <div class="absolute inset-0 w-full h-full overflow-hidden mix-blend-screen opacity-90">
      <Image 
        id="base-hands-layer"
        src={bgImage}
        alt=""
        class="base-wave absolute inset-0 w-full h-full object-contain object-center"
        fetchpriority="high"
        loading="eager"
        decoding="sync"
      />
    </div>

    <!-- Expanding Residue Overlay -->
    <div class="absolute inset-0 w-full h-full overflow-hidden mix-blend-screen opacity-90">
      <div 
        id="residue-layer"
        class="residue-wave absolute inset-0 w-full h-full bg-contain bg-center bg-no-repeat"
        style={`background-image: url('${bgImage3.src}');`}
      ></div>
    </div>

    <!-- Sweeping Glow Ring -->
    <div class="absolute inset-0 w-full h-full overflow-hidden mix-blend-screen opacity-60">
      <!-- The sweeping wave animation -->
      <div 
        id="glow-layer"
        class="glow-wave absolute inset-0 w-full h-full bg-contain bg-center bg-no-repeat"
        style={`background-image: url('${bgImage2.src}');`}
      ></div>
    </div>

    <!-- Center Readability Dimmer -->
    <div id="readability-dimmer" class="readability-dimmer absolute inset-0 w-full h-full mix-blend-normal"></div>
  </div>

  <Nav active="connect" showBack={true} />
  <div class="page-frame" aria-hidden="true"></div>

  <main class="page-content">
    <ContactComponent />
  </main>
</BaseLayout>

<script>
  // Ensure animation plays flawlessly after Astro view transitions finish
  document.addEventListener('astro:page-load', () => {
    const glowLayer = document.getElementById('glow-layer');
    const residueLayer = document.getElementById('residue-layer');
    const baseLayer = document.getElementById('base-hands-layer');
    
    if (glowLayer && residueLayer && baseLayer) {
      // Synchronously reset and trigger animations to avoid async setTimeout glitches
      glowLayer.classList.remove('is-animating');
      residueLayer.classList.remove('is-animating');
      baseLayer.classList.remove('is-animating');
      
      // Force browser reflow
      void glowLayer.offsetWidth;
      
      glowLayer.classList.add('is-animating');
      residueLayer.classList.add('is-animating');
      baseLayer.classList.add('is-animating');
    }
  });
</script>

<style>
  .page-content {
    position: relative;
    z-index: 1;
  }

  /* Master Animation Group ensuring a perfect aspect ratio regardless of rotation */
  .master-animation-group {
    width: 100vmax;
    height: 100vmax;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  /* Rotate the entire animation sequence on mobile screens to fill the vertical space */
  @media (max-width: 768px) and (orientation: portrait) {
    .master-animation-group {
      transform: translate(-50%, -50%) rotate(90deg);
    }
  }

  .glow-wave {
    /* Create a distinct, thick ring mask */
    -webkit-mask-image: radial-gradient(circle, transparent 30%, rgba(0,0,0,0.8) 40%, black 50%, rgba(0,0,0,0.8) 60%, transparent 70%);
    mask-image: radial-gradient(circle, transparent 30%, rgba(0,0,0,0.8) 40%, black 50%, rgba(0,0,0,0.8) 60%, transparent 70%);
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    opacity: 0;
  }

  .base-wave {
    /* Create a solid expanding circle mask identical to the residue wave */
    -webkit-mask-image: radial-gradient(circle, black 0%, black 50%, transparent 60%);
    mask-image: radial-gradient(circle, black 0%, black 50%, transparent 60%);
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    opacity: 0;
  }

  .residue-wave {
    /* Create a solid expanding circle mask */
    -webkit-mask-image: radial-gradient(circle, black 0%, black 50%, transparent 60%);
    mask-image: radial-gradient(circle, black 0%, black 50%, transparent 60%);
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    opacity: 0;

    /* 
      Base state: Slight 1px thickness boost, with a subtle 50% ambient glow.
    */
    filter: 
      drop-shadow(0 0 1px rgba(255, 255, 255, 0.4))
      drop-shadow(0 0 10px rgba(255, 255, 255, 0.3))
      drop-shadow(0 0 20px rgba(255, 255, 255, 0.15))
      brightness(1.1);

    /* Smoothly transition the filter properties */
    transition: filter 0.8s ease-in-out;
  }

  /* Only play the animation when injected by Javascript */
  .base-wave.is-animating {
    animation: sweepResidue 2.5s ease-in-out forwards;
  }

  .glow-wave.is-animating {
    animation: sweepRadial 2.5s ease-in-out forwards;
    animation-delay: 0.3s;
  }
  
  .residue-wave.is-animating {
    animation: sweepResidue 2.5s ease-in-out forwards;
    animation-delay: 0.3s;
  }

  .readability-dimmer {
    /* Focuses the dimming squarely on the center connection point to protect the text links */
    background: radial-gradient(circle at center, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.65) 12%, transparent 35%);
    opacity: 1;
  }

  @keyframes sweepRadial {
    0% {
      -webkit-mask-size: 0% 0%;
      mask-size: 0% 0%;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    100% {
      /* Pause the ring's expansion so the glowing ring rests perfectly on the outer strands, and fully fade it out */
      -webkit-mask-size: 190% 190%;
      mask-size: 190% 190%;
      opacity: 0;
    }
  }

  @keyframes sweepResidue {
    0% {
      -webkit-mask-size: 0% 0%;
      mask-size: 0% 0%;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    100% {
      /* Solid circle fully covers the screen and remains permanently */
      -webkit-mask-size: 350% 350%;
      mask-size: 350% 350%;
      opacity: 1;
    }
  }

  /* Smoothly transition the filter UP when hovering */
  :global(body:has(.contact-link:hover)) .residue-wave {
    filter: 
      drop-shadow(0 0 1px rgba(255, 255, 255, 0.4))
      drop-shadow(0 0 10px rgba(255, 255, 255, 0.3))
      drop-shadow(0 0 15px rgba(255, 255, 255, 0.4))
      brightness(1.3);
  }
</style>
