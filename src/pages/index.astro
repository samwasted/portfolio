---
/**
 * Main page — Single viewport landing with hero + nav.
 * Projects, Editorials, Contact are separate pages.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ShaderBackground from '../components/ShaderBackground.astro';
import Nav from '../components/Nav.astro';
import FujiShaderOverlay from '../components/FujiShaderOverlay.astro';
---

<BaseLayout title="Samarpan Verma — Portfolio" bodyClass="no-scroll">
  <ShaderBackground />
  <FujiShaderOverlay />
  <div class="page-frame" aria-hidden="true"></div>
  <Nav />

  <div class="home-viewport">


    <!-- Hero text -->
    <main class="hero-content">
      <h1 class="hero-greeting">Hi there!</h1>
      <p class="hero-label">I am</p>
      <h2 class="hero-name">Samarpan Verma</h2>
      <p class="hero-subtitle">3rd year <span class="highlight">Mathematics &amp; Computing</span> student at <span class="highlight">IIT (BHU) Varanasi</span></p>
      <div class="hero-tags">
        <span class="tag">C++</span>
        <span class="tag-dot">&bull;</span>
        <span class="tag">Systems</span>
        <span class="tag-dot">&bull;</span>
        <span class="tag">Algorithms</span>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .home-viewport {
    position: fixed;
    inset: 1rem;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
  }

  .home-viewport > * {
    pointer-events: auto;
  }

  /* --- Bird figure — bleeds out of top-right corner --- */
  .hero-figure {
    position: absolute;
    top: -2%;
    right: -2%;
    width: clamp(220px, 22vw, 380px);
    height: auto;
    object-fit: contain;
    z-index: 1;
    filter: grayscale(0.2);
    opacity: 0.85;
    pointer-events: none;
    user-select: none;
  }

  /* --- Hero text — left-center area --- */
  .hero-content {
    position: absolute;
    left: 8%;
    top: 45%;
    transform: translateY(-50%);
    z-index: 2;
  }

  .hero-greeting {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 500;
    color: #D4C594; /* Phosphor Amber */
    margin: 0 0 0.2rem 0;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .hero-label {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 500;
    color: #D4C594;
    opacity: 0.8;
    margin: 0 0 0.2rem 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-name {
    font-family: 'EB Garamond', serif;
    font-size: 5rem;
    font-weight: 500;
    color: #FFFFFF;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin: 0;
  }

  .hero-subtitle {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(212, 197, 148, 0.7); /* #D4C594 at 70% opacity */
    margin: 1.2rem 0 0 0;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero-subtitle .highlight {
    color: #FFF3C7;
    font-weight: 600;
  }

  .hero-tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.2rem 0 0 0;
  }

  .hero-tags .tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: #D4C594;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 0.35rem 0.6rem 0.3rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-tags .tag-dot {
    display: flex;
    align-items: center;
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.8rem;
    line-height: 1;
  }

  /* --- Mobile --- */
  @media (max-width: 768px) {
    .hero-figure {
      width: 160px;
      top: -1%;
      right: -3%;
    }

    .home-nav {
      top: auto;
      bottom: 3rem;
      right: 50%;
      transform: translateX(50%);
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .nav-main,
    .nav-secondary {
      align-items: center;
    }

    .hero-content {
      left: 6%;
      top: 45%;
    }

    .hero-greeting {
      font-size: var(--text-2xl);
    }

    .hero-name {
      font-size: var(--text-3xl);
    }
  }
</style>
