---
/**
 * Main page — Single viewport landing with hero + nav.
 * Projects, Editorials, Contact are separate pages.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import ShaderBackground from "../components/ShaderBackground.astro";
import Nav from "../components/Nav.astro";
import FujiShaderOverlay from "../components/FujiShaderOverlay.astro";
import EventLedger from "../components/EventLedger.astro";
import { existsSync, readFileSync } from "node:fs";
import { createHash } from "node:crypto";

// Real metadata for the resume listing; the entry is hidden until public/resume.pdf exists
const resumePath = "public/resume.pdf";
const resume = existsSync(resumePath)
  ? (() => {
      const buf = readFileSync(resumePath);
      return {
        size: `${Math.round(buf.length / 1024)} KB`,
        md5: createHash("md5").update(buf).digest("hex").slice(0, 16),
      };
    })()
  : null;
---

<BaseLayout title="Samarpan Verma - Portfolio">
  <ShaderBackground />
  <FujiShaderOverlay />
  <div class="page-frame" aria-hidden="true"></div>
  <Nav />

  <!-- Hero Section (Vanilla CSS) -->
  <!-- Hero Section (Fixed in place) -->
  <div class="home-viewport">
    <main class="hero-content">
      <h1
        id="hero-greeting"
        class="hero-greeting transition-opacity duration-300"
      >
        Hi there!
      </h1>
      <p id="hero-label" class="hero-label transition-opacity duration-300">
        I am
      </p>
      <div
        id="hero-sticky-group"
        class="transition-transform duration-[0ms] ease-linear"
      >
        <h2 class="hero-name">Samarpan Verma</h2>
        <p id="hero-subtitle" class="hero-subtitle transition-opacity duration-300">
          3rd year <span class="highlight">Mathematics &amp; Computing</span> student
          at <span class="highlight">IIT (BHU) Varanasi</span>
        </p>
      </div>
      <div id="hero-tags" class="hero-tags transition-opacity duration-300">
        <span class="tag">C++</span>
        <span class="tag-dot">&bull;</span>
        <span class="tag">Systems</span>
        <span class="tag-dot">&bull;</span>
        <span class="tag">Algorithms</span>
      </div>
    </main>

    <!-- Scroll Down Icon (will fade out on scroll) -->
    <div
      id="scroll-indicator-container"
      class="absolute bottom-12 left-1/2 -translate-x-1/2 transition-opacity duration-300"
    >
      <a
        href="#about"
        id="scroll-down-btn"
        class="scroll-indicator"
        aria-label="Scroll to About Me"
      >
        <svg
          class="scroll-arrow"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg
        >
        <span class="scroll-text">More About Me</span>
      </a>
    </div>
  </div>

  <!-- Spacer to push the scroll content down by one screen height -->
  <div class="h-[100vh] w-full relative z-0 pointer-events-none"></div>

  <!-- About Section (Scrolls up) -->
  <section
    id="about"
    class="min-h-screen w-full relative z-30 flex items-start bg-gradient-to-b from-transparent via-[#0a0a0a] to-[#0a0a0a]"
    style="padding: max(15vh, 7rem) 12vw 10vh 8vw;"
  >
    <div class="w-full h-full">
      <!-- Full Width Grid Layout -->
      <div
        class="w-full h-full grid grid-cols-1 lg:grid-cols-12 gap-x-12 text-white flex flex-col gap-5"
      >
        <!-- PANE 1: Chronological Event Ledger (Left Side, Centered) -->
        <div
          class="lg:col-span-6 flex flex-col justify-start gap-6 text-lg mt-16"
        >
          <div
            class="text-[#D4C594] font-mono text-sm tracking-widest uppercase border-b border-white/10 pb-4"
          >
            System Log // Event Ledger
          </div>

          <EventLedger />
        </div>

        <!-- Right Panes 2 & 3 (Top Right & Bottom Right) -->
        <div
          class="lg:col-span-4 lg:col-start-9 flex flex-col h-full mt-24 lg:mt-16 gap-5"
        >
          <!-- PANE 2: Environment Dependencies & Registries (Top Right) -->
          <div class="flex flex-col gap-6 pt-4 lg:pt-0">
            <div
              class="text-[#D4C594] font-mono text-sm tracking-widest uppercase border-b border-white/10 pb-4"
            >
              Environment & Registries
            </div>

            <div
              class="font-mono text-base text-white/30 leading-loose flex flex-col"
              data-tree-print
            >
              <div><span class="tree-glyph">├──</span> <span class="text-[#D4C594]/80">stack/</span></div>

              <div>
                <span class="tree-glyph">│&nbsp;&nbsp;├──</span> <span class="text-white">cpp17</span>
                <span class="text-[#D4C594]/50 text-sm ml-2"
                  >#define int ll</span>
              </div>
              <div>
                <span class="tree-glyph">│&nbsp;&nbsp;└──</span> <span class="text-white">python3</span>
              </div>
              <div><span class="tree-glyph">├──</span> <span class="text-[#D4C594]/80">domains/</span></div>

              <div>
                <span class="tree-glyph">│&nbsp;&nbsp;├──</span> <span class="text-white">competitive_programming</span>
              </div>
              <div>
                <span class="tree-glyph">│&nbsp;&nbsp;├──</span> <span class="text-white"
                  >process_isolation</span>
              </div>
              <div>
                <span class="tree-glyph">│&nbsp;&nbsp;├──</span> <span class="text-white"
                  >low_latency</span>
              </div>
              <div>
                <span class="tree-glyph">│&nbsp;&nbsp;└──</span> <span class="text-white"
                  >quantitative_finance</span>
              </div>  
              <div>
                <span class="tree-glyph">└──</span> <span class="text-[#D4C594]/80">remote/</span>
                <span class="text-[#D4C594]/50 text-sm ml-2"
                  ># hyperlinks btw</span>
              </div>

              <div class="inline-flex items-center link-group group w-fit">
                <span class="tree-glyph">&nbsp;&nbsp;&nbsp;├──&nbsp;</span><a
                  href="https://codeforces.com/profile/aceclofenac"
                  target="_blank"
                  rel="noopener"
                  class="tree-link ml-1"
                  >codeforces</a
                ><span class="tree-link-arrow" aria-hidden="true">↗</span>
              </div>

              <div class="inline-flex items-center link-group group w-fit">
                <span class="tree-glyph">&nbsp;&nbsp;&nbsp;└──&nbsp;</span><a
                  href="https://github.com/samwasted"
                  target="_blank"
                  rel="noopener"
                  class="tree-link ml-1"
                  >github</a
                ><span class="tree-link-arrow" aria-hidden="true">↗</span>
              </div>
            </div>
          </div>

          <!-- PANE 3: System Egress Protocols (Bottom Right) -->
          <div class="flex flex-col gap-6 pb-4 mt-8 lg:mt-[8rem]">
            <div
              class="text-[#D4C594] font-mono text-sm tracking-widest uppercase border-b border-white/10 pb-4"
            >
              System Egress
            </div>

            <div class="font-mono text-base space-y-6">
              <!-- Contact -->
              <div
                id="copy-mail-btn"
                class="block group cursor-pointer select-none"
              >
                <span
                  class="text-[#D4C594] group-hover:text-white transition-colors"
                  >> [ <span id="mail-btn-text">initiate_remote_protocol</span><span
                    class="opacity-0 group-hover:opacity-100 text-white inline-block w-2 ml-1"
                    >_</span
                  > ]</span
                >
                <span id="mail-btn-comment" class="text-[#D4C594]/50 text-sm ml-2"># copy my mail</span>
                <div
                  class="pl-4 text-white/40 text-sm mt-2 border-l border-white/10 ml-2"
                >
                  <span class="opacity-50">email:</span> samarpan.verma.mat24@itbhu.ac.in
                </div>
              </div>

              <!-- Resume -->
              {resume && (
              <a
                href="/resume.pdf"
                target="_blank"
                class="block group cursor-pointer"
              >
                <span
                  class="text-[#D4C594] group-hover:text-white transition-colors"
                  >> [ download_resume.pdf<span
                    class="opacity-0 group-hover:opacity-100 text-white inline-block w-2 ml-1"
                    >_</span
                  > ]</span
                >
                <div
                  class="pl-4 text-white/40 text-sm mt-2 border-l border-white/10 ml-2 flex flex-col space-y-1"
                >
                  <div><span class="opacity-50">size:</span> {resume.size}</div>
                  <div>
                    <span class="opacity-50">type:</span> application/pdf
                  </div>
                  <div>
                    <span class="opacity-50">md5:&nbsp;</span> {resume.md5}
                  </div>
                </div>
              </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  let isTicking = false;

  function updateScrollState() {
    const scrollY = window.scrollY;
    const height = window.innerHeight;

    // Fetch elements dynamically so they are always accurate after Astro ViewTransitions
    const fuji = document.getElementById("fuji-shader-overlay");
    const bg = document.getElementById("image-bg");
    const indicator = document.getElementById("scroll-indicator-container");
    const greeting = document.getElementById("hero-greeting");
    const label = document.getElementById("hero-label");
    const tags = document.getElementById("hero-tags");
    const subtitle = document.getElementById("hero-subtitle");
    const stickyGroup = document.getElementById("hero-sticky-group");

    // 1. Hide scroll indicator
    if (indicator) {
      indicator.style.opacity = scrollY > 50 ? "0" : "1";
      indicator.style.pointerEvents = scrollY > 50 ? "none" : "auto";
    }

    // 2. Fade out secondary text in the first 200px of scrolling
    const fadeOpacity = Math.max(0, 1 - scrollY / 200).toString();
    const pointerEvents = scrollY > 150 ? "none" : "auto";
    
    if (greeting) {
      greeting.style.opacity = fadeOpacity;
      greeting.style.pointerEvents = pointerEvents;
    }
    if (label) {
      label.style.opacity = fadeOpacity;
      label.style.pointerEvents = pointerEvents;
    }
    if (tags) {
      tags.style.opacity = fadeOpacity;
      tags.style.pointerEvents = pointerEvents;
    }
    if (subtitle) {
      subtitle.style.opacity = fadeOpacity;
      subtitle.style.pointerEvents = pointerEvents;
    }

    // 3. Keep the Name and "3rd year" text completely fixed
    const scrollThreshold = height * 0.4;
    if (stickyGroup) {
      if (scrollY > scrollThreshold) {
        const pushUpAmount = scrollY - scrollThreshold;
        if (stickyGroup.parentElement) {
          const heroRect = stickyGroup.parentElement.getBoundingClientRect();
          const initialTop = height * 0.35 - heroRect.height / 2;
          
          // Pull the name higher up, but keep it on screen
          const maxPushUp = initialTop + 10; 
          const clampedPushUp = Math.min(pushUpAmount, maxPushUp);

          stickyGroup.style.transform = `translateY(-${clampedPushUp}px)`;

          const about = document.getElementById("about");
          const overscroll = about ? scrollY - about.offsetTop : 0;
          stickyGroup.style.opacity = Math.max(0, Math.min(1, 1 - overscroll / 120)).toString();
        }
      } else {
        stickyGroup.style.transform = `translateY(0px)`;
        stickyGroup.style.opacity = "1";
      }
    }

    // Shader and Background fades
    if (fuji) {
      const opacity = Math.max(0.3, 1 - scrollY / (height * 0.6));
      fuji.style.opacity = opacity.toString();
    }
    if (bg) {
      bg.style.filter = `brightness(${Math.max(0.2, 1 - scrollY / 800)})`;
    }
  }

  let lastScrollY = window.scrollY;

  window.addEventListener("scroll", () => {
    if (!isTicking) {
      window.requestAnimationFrame(() => {
        const currentScrollY = window.scrollY;
        updateScrollState();
        
        // Momentum Scroll Snapping Logic
        if (!isAutoScrolling) {
          const isMobile = window.innerWidth <= 900 || window.innerHeight <= 650;
          const aboutSection = document.getElementById('about');
          const targetScroll = aboutSection ? aboutSection.offsetTop : (document.body.scrollHeight - window.innerHeight);
          const snapThreshold = isMobile ? targetScroll - 250 : targetScroll + 100;
          
          const scrollingUp = currentScrollY < lastScrollY;
          
          // If scrolling up natively and we cross the threshold into the home screen, snap to top
          if (scrollingUp && currentScrollY <= snapThreshold && currentScrollY > 50) {
            isAutoScrolling = true;
            customSmoothScroll(0, 1000);
            setTimeout(() => { isAutoScrolling = false; }, 1200);
          }
        }
        
        lastScrollY = currentScrollY;
        isTicking = false;
      });
      isTicking = true;
    }
  });

  // Instantly sync state when returning to the page via Astro ViewTransitions
  document.addEventListener('astro:page-load', () => {
    if (window.location.pathname === '/') {
      updateScrollState();
    }
  });

  // Custom smooth scroll function for butter-smooth button click
  function customSmoothScroll(targetPosition: number, duration: number) {
    const startPosition = window.scrollY;
    const distance = targetPosition - startPosition;
    let startTime: number | null = null;

    function animation(currentTime: number) {
      if (startTime === null) startTime = currentTime;
      const timeElapsed = currentTime - startTime;
      const progress = Math.min(timeElapsed / duration, 1);

      // Easing function (easeInOutCubic)
      const ease =
        progress < 0.5
          ? 4 * progress * progress * progress
          : 1 - Math.pow(-2 * progress + 2, 3) / 2;

      // Do NOT use Math.round, it causes stair-step stutter on 120Hz/Retina screens
      window.scrollTo(0, startPosition + distance * ease);

      if (timeElapsed < duration) {
        requestAnimationFrame(animation);
      }
    }
    requestAnimationFrame(animation);
  }

  // Auto-scroll logic via wheel event
  let isAutoScrolling = false;

  window.addEventListener(
    "wheel",
    (e) => {
      // ONLY run this cinematic scroll on the home page!
      // Otherwise it hijacks scrolling on all other pages during View Transitions.
      if (window.location.pathname !== '/' && window.location.pathname !== '/index.html') return;

      if (isAutoScrolling) {
        e.preventDefault();
        return;
      }

      const scrollY = window.scrollY;
      const maxScroll = document.body.scrollHeight - window.innerHeight;
      const scrollingDown = e.deltaY > 0;

      const aboutSection = document.getElementById('about');
      const targetScroll = aboutSection ? aboutSection.offsetTop : maxScroll;

      const isMobile = window.innerWidth <= 900 || window.innerHeight <= 650;
      const snapThreshold = isMobile ? targetScroll - 250 : targetScroll + 100;

      // If at the top and scrolling down
      if (scrollingDown && scrollY < 50) {
        e.preventDefault();
        isAutoScrolling = true;
        customSmoothScroll(targetScroll, 1000);
        setTimeout(() => {
          isAutoScrolling = false;
        }, 1200);
      }
      // If pulled past the top of the About section and scrolling up
      else if (!scrollingDown && scrollY <= snapThreshold && scrollY > 50) {
        e.preventDefault();
        isAutoScrolling = true;
        customSmoothScroll(0, 1000);
        setTimeout(() => {
          isAutoScrolling = false;
        }, 1200);
      }
    },
    { passive: false }
  );

  let touchStartY = 0;
  window.addEventListener('touchstart', (e) => {
    if (window.location.pathname !== '/' && window.location.pathname !== '/index.html') return;
    touchStartY = e.touches[0].clientY;
  }, { passive: true });

  window.addEventListener('touchmove', (e) => {
    if (window.location.pathname !== '/' && window.location.pathname !== '/index.html') return;
    if (isAutoScrolling) {
      e.preventDefault();
      return;
    }
    
    const touchEndY = e.touches[0].clientY;
    const deltaY = touchStartY - touchEndY;
    const scrollY = window.scrollY;
    const maxScroll = document.body.scrollHeight - window.innerHeight;
    
    const aboutSection = document.getElementById('about');
    const targetScroll = aboutSection ? aboutSection.offsetTop : maxScroll;
    
    // Only trigger cinematic scroll if the swipe is significant enough
    if (Math.abs(deltaY) < 40) return;
    
    const scrollingDown = deltaY > 0;
    
    const isMobile = window.innerWidth <= 900 || window.innerHeight <= 650;
    const snapThreshold = isMobile ? targetScroll - 250 : targetScroll + 100;

    if (scrollingDown && scrollY < 50) {
      e.preventDefault();
      isAutoScrolling = true;
      customSmoothScroll(targetScroll, 1000);
      setTimeout(() => { isAutoScrolling = false; }, 1200);
    } else if (!scrollingDown && scrollY <= snapThreshold && scrollY > 50) {
      e.preventDefault();
      isAutoScrolling = true;
      customSmoothScroll(0, 1000);
      setTimeout(() => { isAutoScrolling = false; }, 1200);
    }
  }, { passive: false });

  // Use event delegation in the CAPTURE phase so listeners intercept the click
  // BEFORE Astro's ViewTransitions router can see it and trigger a reload.
  document.addEventListener(
    "click",
    (e) => {
      const target = e.target as Element;
      if (!target || typeof target.closest !== "function") return;

      // Copy Mail Protocol
      if (target.closest("#copy-mail-btn")) {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        
        navigator.clipboard.writeText("samarpan.verma.mat24@itbhu.ac.in").catch(() => {});
        
        const btnText = document.getElementById("mail-btn-text");
        const btnComment = document.getElementById("mail-btn-comment");
        
        if (btnText && btnComment) {
          btnText.textContent = "text_copied_to_clipboard";
          btnComment.textContent = "ACK";
          
          setTimeout(() => {
            btnText.textContent = "initiate_remote_protocol";
            btnComment.textContent = "# copy my mail";
          }, 1500);
        }
        return;
      }

      // Smooth scroll for the down arrow
      if (target.closest("#scroll-down-btn")) {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();

        const aboutSection = document.getElementById('about');
        const targetScroll = aboutSection ? aboutSection.offsetTop : (document.body.scrollHeight - window.innerHeight);

        if (isAutoScrolling) return;
        isAutoScrolling = true;
        customSmoothScroll(targetScroll, 1000);
        setTimeout(() => {
          isAutoScrolling = false;
        }, 1200);
        return;
      }

      // Toggle scroll for the "About me" nav link
      if (target.closest("#nav-about-link")) {
        // If we are on the home page, intercept the click and scroll
        if (window.location.pathname === "/") {
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();

          if (isAutoScrolling) return;

          const maxScroll = document.body.scrollHeight - window.innerHeight;
          isAutoScrolling = true;

          const aboutSection = document.getElementById('about');
          const targetScroll = aboutSection ? aboutSection.offsetTop : maxScroll;

          // If we're at the top, scroll down to About. If we're at the bottom, scroll up to Home.
          if (window.scrollY < targetScroll / 2) {
            customSmoothScroll(targetScroll, 1000);
          } else {
            customSmoothScroll(0, 1000);
          }

          setTimeout(() => {
            isAutoScrolling = false;
          }, 1200);
        }
      }
    },
    { capture: true },
  );

  // Draw the registry tree's connectors line by line every time it scrolls
  // into view (reset once it has fully left); the names themselves stay put
  function initTreePrint() {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.querySelectorAll<HTMLElement>("[data-tree-print]:not([data-tree-init])").forEach((tree) => {
      tree.dataset.treeInit = "";
      if (reduceMotion || !("IntersectionObserver" in window)) return;

      Array.from(tree.children).forEach((line, i) => {
        (line as HTMLElement).style.setProperty("--line", String(i));
      });

      // Hidden only once JS is running, so the tree still shows without it
      tree.classList.add("tree-pending");
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.intersectionRatio >= 0.25) {
              tree.classList.add("tree-print");
            } else if (!e.isIntersecting) {
              tree.classList.remove("tree-print");
            }
          }
        },
        { threshold: [0, 0.25] },
      );
      io.observe(tree);
    });
  }

  initTreePrint();
  document.addEventListener("astro:page-load", initTreePrint);
</script>

<style>
  html {
    /* No scroll-snap, we handle it via JS now to avoid pulling bugs */
  }

  .home-viewport {
    position: fixed;
    inset: 0;
    z-index: 40;
    overflow: hidden;
    pointer-events: none;
  }

  /* Only allow pointer events on the actual content, not their transparent wrappers */
  .hero-greeting, .hero-label, .hero-name, .hero-subtitle, .hero-tags, .scroll-indicator {
    pointer-events: auto;
  }

  /* --- Bird figure — bleeds out of top-right corner --- */
  .hero-figure {
    position: absolute;
    top: -2%;
    right: -2%;
    width: clamp(220px, 22vw, 380px);
    height: auto;
    object-fit: contain;
    z-index: 1;
    filter: grayscale(0.2);
    opacity: 0.85;
    pointer-events: none;
    user-select: none;
  }

  /* --- Hero text — left-center area --- */
  .hero-content {
    position: absolute;
    left: 8vw;
    top: 35%; /* A bit on top */
    transform: translateY(-50%);
    z-index: 2;
  }

  .hero-greeting {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 500;
    color: #d4c594; /* Phosphor Amber */
    margin: 0 0 0.2rem 0;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .hero-label {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 500;
    color: #d4c594;
    opacity: 0.8;
    margin: 0 0 0.2rem 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-name {
    font-family: "EB Garamond", serif;
    font-size: 5rem;
    font-weight: 500;
    color: #ffffff;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin: 0;
  }

  .hero-subtitle {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(212, 197, 148, 0.7); /* #D4C594 at 70% opacity */
    margin: 1.2rem 0 0 0;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero-subtitle .highlight {
    color: #fff3c7;
    font-weight: 600;
  }

  .hero-tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.2rem 0 0 0;
  }

  .hero-tags .tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: #d4c594;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 0.35rem 0.6rem 0.3rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-tags .tag-dot {
    display: flex;
    align-items: center;
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.8rem;
    line-height: 1;
  }

  /* --- Scroll Indicator --- */
  .scroll-indicator {
    position: absolute;
    bottom: 3rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
    color: #d4c594;
    opacity: 0.7;
    transition: opacity 0.3s ease;
    text-decoration: none;
    z-index: 10;
  }

  .scroll-indicator:hover {
    opacity: 1;
  }

  .scroll-text {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0;
    white-space: nowrap;
  }

  .scroll-arrow {
    width: 1.25rem;
    height: 1.25rem;
