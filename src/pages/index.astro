              <div class="inline-flex items-center link-group group w-fit">
                &nbsp;&nbsp;&nbsp;└──&nbsp;<a
                  href="https://github.com/samwasted"
                  target="_blank"
                  class="cyan-text magenta-hover transition-colors underline decoration-cyan-400/20 underline-offset-4 ml-1"
