---
/**
 * Main page — Single viewport landing with hero + nav.
 * Projects, Editorials, Contact are separate pages.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import ShaderBackground from "../components/ShaderBackground.astro";
import Nav from "../components/Nav.astro";
import FujiShaderOverlay from "../components/FujiShaderOverlay.astro";
---

<BaseLayout title="Samarpan Verma - Portfolio">
  <ShaderBackground />
  <FujiShaderOverlay />
  <div class="page-frame" aria-hidden="true"></div>
  <Nav />

  <!-- Hero Section (Vanilla CSS) -->
  <!-- Hero Section (Fixed in place) -->
  <div class="home-viewport">
    <main class="hero-content">
      <h1
        id="hero-greeting"
        class="hero-greeting transition-opacity duration-300"
      >
        Hi there!
      </h1>
      <p id="hero-label" class="hero-label transition-opacity duration-300">
        I am
      </p>
      <div
        id="hero-sticky-group"
        class="transition-transform duration-[0ms] ease-linear"
      >
        <h2 class="hero-name">Samarpan Verma</h2>
        <p id="hero-subtitle" class="hero-subtitle transition-opacity duration-300">
          3rd year <span class="highlight">Mathematics &amp; Computing</span> student
          at <span class="highlight">IIT (BHU) Varanasi</span>
        </p>
      </div>
      <div id="hero-tags" class="hero-tags transition-opacity duration-300">
        <span class="tag">C++</span>
        <span class="tag-dot">&bull;</span>
        <span class="tag">Systems</span>
        <span class="tag-dot">&bull;</span>
        <span class="tag">Algorithms</span>
      </div>
    </main>

    <!-- Scroll Down Icon (will fade out on scroll) -->
    <div
      id="scroll-indicator-container"
      class="absolute bottom-12 left-1/2 -translate-x-1/2 transition-opacity duration-300"
    >
      <a
        href="#about"
        id="scroll-down-btn"
        class="scroll-indicator"
        aria-label="Scroll to About Me"
      >
        <svg
          class="scroll-arrow"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg
        >
        <span class="scroll-text">More About Me</span>
      </a>
    </div>
  </div>

  <!-- Spacer to push the scroll content down by one screen height -->
  <div class="h-[100vh] w-full relative z-0 pointer-events-none"></div>

  <!-- About Section (Scrolls up) -->
  <section
    id="about"
    class="min-h-screen w-full relative z-30 flex items-center bg-gradient-to-b from-transparent via-[#0a0a0a] to-[#0a0a0a]"
    style="padding: 15vh 12vw 15vh 8vw;"
  >
    <div class="w-full h-full">
      <!-- Full Width Grid Layout -->
      <div
        class="w-full h-full grid grid-cols-1 lg:grid-cols-12 gap-x-12 text-white flex flex-col gap-5"
      >
        <!-- PANE 1: Chronological Event Ledger (Left Side, Centered) -->
        <div
          class="lg:col-span-6 flex flex-col justify-center gap-6 text-lg mt-16"
        >
          <div
            class="text-[#D4C594] font-mono text-sm tracking-widest uppercase border-b border-white/10 pb-4"
          >
            System Log // Event Ledger
          </div>

          <div class="font-mono text-base flex flex-col gap-5 text-white/60 relative">
            <!-- Vertical line behind nodes -->
            <div class="absolute left-[176px] top-2 bottom-2 w-px bg-white/10 z-0 hidden md:block"></div>

            <!-- [BASE] Standard -->
            <div class="flex gap-4 group items-start relative z-10">
              <div class="text-[#D4C594]/60 whitespace-nowrap w-[155px] flex-shrink-0 text-left md:text-right transition-opacity">
                [BASE] 2024-07
              </div>
              <div class="flex-col items-center justify-start w-[10px] flex-shrink-0 hidden md:flex" style="transform: translateY(10px);">
                <div class="w-2 h-2 rounded-full bg-[#1a1a1a] border border-white/20 group-hover:border-white/40 group-hover:bg-white/10 transition-colors"></div>
              </div>
              <div class="text-white/20 select-none md:hidden flex-shrink-0">|</div>
              <div class="text-white/40 leading-relaxed group-hover:text-white/70 transition-colors flex-1">
                System initialization: Admitted to Indian Institute of Technology (IIT) BHU, Varanasi. Enrolled in Mathematics and Computing (IDD).
              </div>
            </div>



            <!-- [INDUCT] Standard -->
            <div class="flex gap-4 group items-start relative z-10">
              <div class="text-[#D4C594]/60 whitespace-nowrap w-[155px] flex-shrink-0 text-left md:text-right transition-opacity">
                [INDUCT] 2025-06
              </div>
              <div class="flex-col items-center justify-start w-[10px] flex-shrink-0 hidden md:flex" style="transform: translateY(10px);">
                <div class="w-2 h-2 rounded-full bg-[#1a1a1a] border border-white/20 group-hover:border-white/40 group-hover:bg-white/10 transition-colors"></div>
              </div>
