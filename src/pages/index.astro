    <div class="w-full h-full">
      <!-- Full Width Grid Layout -->
      <div class="w-full h-full grid grid-cols-1 lg:grid-cols-12 gap-x-12 text-white">
        
        <!-- PANE 1: Chronological Event Ledger (Left Side, Centered) -->
        <div class="lg:col-span-6 flex flex-col justify-center space-y-8">
          <div class="text-[#D4C594] font-mono text-xs tracking-widest uppercase border-b border-white/10 pb-4">
            System Log // Event Ledger
          </div>
          
          <div class="font-mono text-[0.8rem] space-y-5 text-white/60">
            <div class="flex gap-4 group">
              <div class="text-[#D4C594] whitespace-nowrap min-w-[110px] opacity-80 group-hover:opacity-100 transition-opacity">[RANK] 2026-04</div>
              <div class="text-white/20 select-none">|</div>
              <div class="text-white/90 leading-relaxed">Codeforces Expert Rank profile validation.</div>
            </div>
            
            <div class="flex gap-4 group">
              <div class="text-[#D4C594] whitespace-nowrap min-w-[110px] opacity-80 group-hover:opacity-100 transition-opacity">[AWARD] 2026-03</div>
              <div class="text-white/20 select-none">|</div>
              <div class="text-white/90 leading-relaxed">Bronze Medal at Inter IIT Tech Meet 14.0 (Quant Problem Statement).</div>
            </div>

            <div class="flex gap-4 group">
              <div class="text-[#FFF3C7] whitespace-nowrap min-w-[110px] opacity-80 group-hover:opacity-100 transition-opacity">[LAUNCH] 2026-03</div>
              <div class="text-white/20 select-none">|</div>
              <div class="text-white/90 leading-relaxed">"Rent-a-Romeo" Matchmaking Engine deployment trace.</div>
            </div>

            <div class="flex gap-4 group">
              <div class="text-[#FFF3C7] whitespace-nowrap min-w-[110px] opacity-80 group-hover:opacity-100 transition-opacity">[LAUNCH] 2026-01</div>
              <div class="text-white/20 select-none">|</div>
              <div class="text-white/90 leading-relaxed">"jailsh" Unix Sandbox Runtime kernel implementation logs (seccomp-BPF, namespaces).</div>
            </div>
          </div>
        </div>

        <!-- Right Panes 2 & 3 (Top Right & Bottom Right) -->
        <div class="lg:col-span-4 lg:col-start-9 flex flex-col space-y-24 lg:space-y-32 h-full">
          
          <!-- PANE 2: Environment Dependencies & Registries (Top Right) -->
          <div class="space-y-6 pt-4">
            <div class="text-[#D4C594] font-mono text-xs tracking-widest uppercase border-b border-white/10 pb-4">
              Environment & Registries
            </div>
            
            <div class="font-mono text-[0.8rem] text-white/30 leading-loose flex flex-col">
              <div>.</div>
              <div>├── <span class="text-[#D4C594]/80">bin/</span></div>
              
              <div class="inline-flex items-center link-group group w-fit">│&nbsp;&nbsp;├── <span class="text-white group-hover:text-pink-400 transition-colors ml-1 cursor-default">cpp17</span><svg class="w-3 h-3 ml-2 text-pink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path class="flower-petal" d="M12 22V13 M12 13C8 13 5 10 5 6C8 6 12 10 12 13 M12 13C16 13 19 10 19 6C16 6 12 10 12 13" /></svg><span class="text-[#D4C594]/50 text-[0.7rem] ml-2">#define int ll</span></div>
              
              <div class="inline-flex items-center link-group group w-fit">│&nbsp;&nbsp;├── <span class="text-white group-hover:text-pink-400 transition-colors ml-1 cursor-default">python3</span><svg class="w-3 h-3 ml-2 text-pink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path class="flower-petal" d="M12 22V13 M12 13C8 13 5 10 5 6C8 6 12 10 12 13 M12 13C16 13 19 10 19 6C16 6 12 10 12 13" /></svg></div>
              
              <div class="inline-flex items-center link-group group w-fit">│&nbsp;&nbsp;└── <span class="text-white group-hover:text-pink-400 transition-colors ml-1 cursor-default">glsl</span><svg class="w-3 h-3 ml-2 text-pink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path class="flower-petal" d="M12 22V13 M12 13C8 13 5 10 5 6C8 6 12 10 12 13 M12 13C16 13 19 10 19 6C16 6 12 10 12 13" /></svg></div>
              
              <div>├── <span class="text-[#D4C594]/80">sys/</span></div>
              
              <div class="inline-flex items-center link-group group w-fit">│&nbsp;&nbsp;├── <span class="text-white group-hover:text-pink-400 transition-colors ml-1 cursor-default">seccomp-bpf</span><svg class="w-3 h-3 ml-2 text-pink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path class="flower-petal" d="M12 22V13 M12 13C8 13 5 10 5 6C8 6 12 10 12 13 M12 13C16 13 19 10 19 6C16 6 12 10 12 13" /></svg></div>
              
              <div class="inline-flex items-center link-group group w-fit">│&nbsp;&nbsp;└── <span class="text-white group-hover:text-pink-400 transition-colors ml-1 cursor-default">linux_namespaces</span><svg class="w-3 h-3 ml-2 text-pink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path class="flower-petal" d="M12 22V13 M12 13C8 13 5 10 5 6C8 6 12 10 12 13 M12 13C16 13 19 10 19 6C16 6 12 10 12 13" /></svg></div>
              
              <div>└── <span class="text-[#D4C594]/80">remote/</span></div>
              
              <div class="inline-flex items-center link-group group w-fit">&nbsp;&nbsp;&nbsp;├── <a href="https://codeforces.com/profile/amwasted" target="_blank" class="text-white group-hover:text-pink-400 transition-colors underline decoration-white/20 underline-offset-4 ml-1">cf/amwasted</a><svg class="w-3 h-3 ml-2 text-pink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path class="flower-petal" d="M12 22V13 M12 13C8 13 5 10 5 6C8 6 12 10 12 13 M12 13C16 13 19 10 19 6C16 6 12 10 12 13" /></svg></div>
              
              <div class="inline-flex items-center link-group group w-fit">&nbsp;&nbsp;&nbsp;├── <a href="https://leetcode.com/" target="_blank" class="text-white group-hover:text-pink-400 transition-colors underline decoration-white/20 underline-offset-4 ml-1">leetcode</a><svg class="w-3 h-3 ml-2 text-pink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path class="flower-petal" d="M12 22V13 M12 13C8 13 5 10 5 6C8 6 12 10 12 13 M12 13C16 13 19 10 19 6C16 6 12 10 12 13" /></svg></div>
              
              <div class="inline-flex items-center link-group group w-fit">&nbsp;&nbsp;&nbsp;├── <a href="https://github.com/samwasted" target="_blank" class="text-white group-hover:text-pink-400 transition-colors underline decoration-white/20 underline-offset-4 ml-1">gh/samwasted</a><svg class="w-3 h-3 ml-2 text-pink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path class="flower-petal" d="M12 22V13 M12 13C8 13 5 10 5 6C8 6 12 10 12 13 M12 13C16 13 19 10 19 6C16 6 12 10 12 13" /></svg></div>
              
              <div class="inline-flex items-center link-group group w-fit">&nbsp;&nbsp;&nbsp;└── <a href="#" class="text-white/50 group-hover:text-pink-400 transition-colors italic ml-1">arxiv_index</a><svg class="w-3 h-3 ml-2 text-pink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path class="flower-petal" d="M12 22V13 M12 13C8 13 5 10 5 6C8 6 12 10 12 13 M12 13C16 13 19 10 19 6C16 6 12 10 12 13" /></svg></div>
            </div>
          </div>

          <!-- PANE 3: System Egress Protocols (Bottom Right) -->
          <div class="space-y-6 pb-4" style="margin-top: 8rem;">
            <div class="text-[#D4C594] font-mono text-xs tracking-widest uppercase border-b border-white/10 pb-4">
              System Egress
            </div>
            
            <div class="font-mono text-[0.8rem] space-y-6">
              <!-- Contact -->
              <a href="mailto:samarpan.verma.mat24@itbhu.ac.in" class="block group cursor-pointer">
                <span class="text-[#D4C594] group-hover:text-white transition-colors">> [ initiate_handshake_protocol<span class="opacity-0 group-hover:opacity-100 animate-pulse text-white inline-block w-2 ml-1">_</span> ]</span>
                <div class="pl-4 text-white/40 text-[0.7rem] mt-2 border-l border-white/10 ml-2">
                  <span class="opacity-50">target:</span> samarpan.verma.mat24@itbhu.ac.in
                </div>
              </a>

              <!-- Resume -->
              <a href="/resume.pdf" target="_blank" class="block group cursor-pointer">
                <span class="text-[#D4C594] group-hover:text-white transition-colors">> [ download_legacy_resume.pdf<span class="opacity-0 group-hover:opacity-100 animate-pulse text-white inline-block w-2 ml-1">_</span> ]</span>
                <div class="pl-4 text-white/40 text-[0.7rem] mt-2 border-l border-white/10 ml-2 flex flex-col space-y-1">
                  <div><span class="opacity-50">size:</span> 142 KB</div>
                  <div><span class="opacity-50">type:</span> application/pdf</div>
                  <div><span class="opacity-50">md5:&nbsp;</span> 8f4e2c9b1a0d3e5f</div>
                </div>
              </a>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Fade out Fuji shader, blur background, and hide scroll arrow based on scroll
  const fuji = document.getElementById('fuji-shader-overlay');
  const bg = document.getElementById('image-bg');
  const indicator = document.getElementById('scroll-indicator-container');
  
  // Hero text elements
  const greeting = document.getElementById('hero-greeting');
  const label = document.getElementById('hero-label');
  const tags = document.getElementById('hero-tags');
  const stickyGroup = document.getElementById('hero-sticky-group');
  
  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;
    const height = window.innerHeight;
    
    // 1. Hide scroll indicator
    if (indicator) {
      indicator.style.opacity = scrollY > 50 ? '0' : '1';
      indicator.style.pointerEvents = scrollY > 50 ? 'none' : 'auto';
    }

    // 2. Fade out secondary text (greeting, label, tags) in the first 200px of scrolling
    const fadeOpacity = Math.max(0, 1 - (scrollY / 200)).toString();
    if (greeting) greeting.style.opacity = fadeOpacity;
    if (label) label.style.opacity = fadeOpacity;
    if (tags) tags.style.opacity = fadeOpacity;

    // 3. Keep the Name and "3rd year" text completely fixed
    // UNTIL a certain scroll threshold is reached, then push it upwards.
    const scrollThreshold = height * 0.4; // Start pushing up much earlier
    if (stickyGroup) {
      if (scrollY > scrollThreshold) {
        // Push the text up at the same speed as the user scrolls
        const pushUpAmount = scrollY - scrollThreshold;
        
        // Calculate the maximum we can push it up before it hits the top border (1rem = 16px)
        // Let's leave 2rem (32px) padding from the top
        if (stickyGroup.parentElement) {
          const heroRect = stickyGroup.parentElement.getBoundingClientRect();
          // Since parent (.hero-content) has a fixed top (35%), we calculate distance from top
          const initialTop = (height * 0.35) - (heroRect.height / 2);
          
          // Max push up is the distance from initial top to the 32px padding
          const maxPushUp = Math.max(0, initialTop - 32);
          
          // Clamp the upward movement so it never crosses the white border
          const clampedPushUp = Math.min(pushUpAmount, maxPushUp);
          
          stickyGroup.style.transform = `translateY(-${clampedPushUp}px)`;
        }
      } else {
        stickyGroup.style.transform = `translateY(0px)`;
      }
    }

    // Shader and Background fades
    if (fuji) {
      const opacity = Math.max(0, 1 - (scrollY / (height * 0.6)));
      fuji.style.opacity = opacity.toString();
    }
    if (bg) {
      const blurAmount = Math.min(15, scrollY / 40);
      bg.style.filter = `blur(${blurAmount}px) brightness(${Math.max(0.2, 1 - scrollY/800)})`;
    }
  });

  // Custom smooth scroll function for butter-smooth button click
  function customSmoothScroll(targetPosition: number, duration: number) {
    const startPosition = window.scrollY;
    const distance = targetPosition - startPosition;
    let startTime: number | null = null;

    function animation(currentTime: number) {
      if (startTime === null) startTime = currentTime;
      const timeElapsed = currentTime - startTime;
      const progress = Math.min(timeElapsed / duration, 1);
      
      // Easing function (easeInOutCubic)
      const ease = progress < 0.5 
        ? 4 * progress * progress * progress 
        : 1 - Math.pow(-2 * progress + 2, 3) / 2;

      window.scrollTo(0, startPosition + distance * ease);

      if (timeElapsed < duration) {
        requestAnimationFrame(animation);
      }
    }
    requestAnimationFrame(animation);
  }

  // Auto-scroll logic via wheel event
  let isAutoScrolling = false;
  
  window.addEventListener('wheel', (e) => {
    if (isAutoScrolling) {
      e.preventDefault();
      return;
    }

    const scrollY = window.scrollY;
    const maxScroll = document.body.scrollHeight - window.innerHeight;
    const scrollingDown = e.deltaY > 0;

    // If at the top and scrolling down
    if (scrollingDown && scrollY < 50) {
      e.preventDefault();
      isAutoScrolling = true;
      customSmoothScroll(maxScroll, 1000);
      setTimeout(() => { isAutoScrolling = false; }, 1200);
    }
    // If at the bottom and scrolling up
    else if (!scrollingDown && scrollY > maxScroll - 50) {
      e.preventDefault();
      isAutoScrolling = true;
      customSmoothScroll(0, 1000);
      setTimeout(() => { isAutoScrolling = false; }, 1200);
    }
  }, { passive: false });

  // Smooth scroll for the down arrow
  document.getElementById('scroll-down-btn')?.addEventListener('click', (e) => {
    e.preventDefault();
    if (isAutoScrolling) return;
    isAutoScrolling = true;
    customSmoothScroll(document.body.scrollHeight - window.innerHeight, 1000);
    setTimeout(() => { isAutoScrolling = false; }, 1200);
  });
</script>

<style>
  html {
    /* No scroll-snap, we handle it via JS now to avoid pulling bugs */
  }

  .home-viewport {
    position: fixed;
    inset: 0;
    z-index: 20;
    overflow: hidden;
    pointer-events: none;
  }

  .home-viewport > * {
    pointer-events: auto;
  }

  /* --- Bird figure — bleeds out of top-right corner --- */
  .hero-figure {
    position: absolute;
    top: -2%;
    right: -2%;
    width: clamp(220px, 22vw, 380px);
    height: auto;
    object-fit: contain;
    z-index: 1;
    filter: grayscale(0.2);
    opacity: 0.85;
    pointer-events: none;
    user-select: none;
  }

  /* --- Hero text — left-center area --- */
  .hero-content {
    position: absolute;
    left: 8vw;
    top: 35%; /* A bit on top */
    transform: translateY(-50%);
    z-index: 2;
  }

  .hero-greeting {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 500;
    color: #D4C594; /* Phosphor Amber */
    margin: 0 0 0.2rem 0;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .hero-label {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 500;
    color: #D4C594;
    opacity: 0.8;
    margin: 0 0 0.2rem 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-name {
    font-family: 'EB Garamond', serif;
    font-size: 5rem;
    font-weight: 500;
    color: #FFFFFF;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin: 0;
  }

  .hero-subtitle {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(212, 197, 148, 0.7); /* #D4C594 at 70% opacity */
    margin: 1.2rem 0 0 0;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero-subtitle .highlight {
    color: #FFF3C7;
    font-weight: 600;
  }

  .hero-tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.2rem 0 0 0;
  }

  .hero-tags .tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: #D4C594;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 0.35rem 0.6rem 0.3rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-tags .tag-dot {
    display: flex;
    align-items: center;
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.8rem;
    line-height: 1;
  }

  /* --- Scroll Indicator --- */
  .scroll-indicator {
    position: absolute;
    bottom: 3rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
    color: #D4C594;
    opacity: 0.7;
    transition: opacity 0.3s ease;
    text-decoration: none;
    z-index: 10;
  }

  .scroll-indicator:hover {
    opacity: 1;
  }

  .scroll-text {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0;
    white-space: nowrap;
  }

  .scroll-arrow {
    width: 1.25rem;
    height: 1.25rem;
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(25%); }
  }

  /* --- Mobile --- */
  @media (max-width: 768px) {
    .hero-figure {
      width: 160px;
      top: -1%;
      right: -3%;
    }

    .hero-content {
      left: 6%;
      top: 35%; /* A bit on top */
    }

    .hero-greeting {
      font-size: var(--text-2xl);
    }

    .hero-name {
      font-size: var(--text-3xl);
    }
  /* --- Flower Petal Unfurling Effect --- */
  .flower-petal {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .link-group:hover .flower-petal {
    stroke-dashoffset: 0;
  }
</style>
