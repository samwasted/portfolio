            >
              System Egress
            </div>

            <div class="font-mono text-base space-y-6">
              <!-- Contact -->
              <div
                id="copy-mail-btn"
                class="block group cursor-pointer select-none"
              >
                <span
                  class="text-[#D4C594] group-hover:text-white transition-colors"
                  >> [ <span id="mail-btn-text">initiate_remote_protocol</span><span
                    class="opacity-0 group-hover:opacity-100 text-white inline-block w-2 ml-1"
                    >_</span
                  > ]</span
                >
                <span id="mail-btn-comment" class="text-[#D4C594]/50 text-sm ml-2"># copy my mail</span>
                <div
                  class="pl-4 text-white/40 text-sm mt-2 border-l border-white/10 ml-2"
                >
                  <span class="opacity-50">email:</span> samarpan.verma.mat24@itbhu.ac.in
                </div>
              </div>

              <!-- Resume -->
              <a
                href="/resume.pdf"
                target="_blank"
                class="block group cursor-pointer"
              >
                <span
                  class="text-[#D4C594] group-hover:text-white transition-colors"
                  >> [ download_resume.pdf<span
                    class="opacity-0 group-hover:opacity-100 text-white inline-block w-2 ml-1"
                    >_</span
                  > ]</span
