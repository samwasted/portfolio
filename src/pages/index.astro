---
/**
 * Main page — Single viewport landing with hero + nav.
 * Projects, Editorials, Contact are separate pages.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ShaderBackground from '../components/ShaderBackground.astro';
import Nav from '../components/Nav.astro';
import FujiShaderOverlay from '../components/FujiShaderOverlay.astro';
---

<BaseLayout title="Samarpan Verma — Portfolio">
  <ShaderBackground />
  <FujiShaderOverlay />
  <div class="page-frame" aria-hidden="true"></div>
  <Nav />

  <!-- Hero Section (Vanilla CSS) -->
  <!-- Hero Section (Fixed in place) -->
  <div class="home-viewport">
    <main class="hero-content">
      <h1 id="hero-greeting" class="hero-greeting transition-opacity duration-300">Hi there!</h1>
      <p id="hero-label" class="hero-label transition-opacity duration-300">I am</p>
      <div id="hero-sticky-group" class="transition-transform duration-[0ms] ease-linear">
        <h2 class="hero-name">Samarpan Verma</h2>
        <p class="hero-subtitle">3rd year <span class="highlight">Mathematics &amp; Computing</span> student at <span class="highlight">IIT (BHU) Varanasi</span></p>
      </div>
      <div id="hero-tags" class="hero-tags transition-opacity duration-300">
        <span class="tag">C++</span>
        <span class="tag-dot">&bull;</span>
        <span class="tag">Systems</span>
        <span class="tag-dot">&bull;</span>
        <span class="tag">Algorithms</span>
      </div>
    </main>

    <!-- Scroll Down Icon (will fade out on scroll) -->
    <div id="scroll-indicator-container" class="absolute bottom-12 left-1/2 -translate-x-1/2 transition-opacity duration-300">
      <a href="#about" id="scroll-down-btn" class="scroll-indicator" aria-label="Scroll to About Me">
        <svg class="scroll-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
        <span class="scroll-text">More About Me</span>
      </a>
    </div>
  </div>

  <!-- Spacer to push the scroll content down by one screen height -->
  <div class="h-[100vh] w-full relative z-0 pointer-events-none"></div>

  <!-- About Section (Scrolls up) -->
  <!-- We leave the left side empty so the fixed Hero text shows through perfectly -->
  <section id="about" class="min-h-screen w-full relative z-10 flex px-8 md:px-[12%] py-32 bg-gradient-to-b from-transparent via-[#0a0a0a]/80 to-[#0a0a0a]">
    <div class="w-full flex justify-end">
      
      <!-- Right Side Content Area -->
      <div class="w-full lg:w-5/12 space-y-24 text-white">
        
        <div class="space-y-8 mt-[40vh]">
          <!-- Content temporarily removed for testing -->
        </div>
        
        <div class="h-[60vh]"></div>
      </div>

    </div>
  </section>
</BaseLayout>

<script>
  // Fade out Fuji shader, blur background, and hide scroll arrow based on scroll
  const fuji = document.getElementById('fuji-shader-overlay');
  const bg = document.getElementById('image-bg');
  const indicator = document.getElementById('scroll-indicator-container');
  
  // Hero text elements
  const greeting = document.getElementById('hero-greeting');
  const label = document.getElementById('hero-label');
  const tags = document.getElementById('hero-tags');
  const stickyGroup = document.getElementById('hero-sticky-group');
  
  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;
    const height = window.innerHeight;
    
    // 1. Hide scroll indicator
    if (indicator) {
      indicator.style.opacity = scrollY > 50 ? '0' : '1';
      indicator.style.pointerEvents = scrollY > 50 ? 'none' : 'auto';
    }

    // 2. Fade out secondary text (greeting, label, tags) in the first 200px of scrolling
    const fadeOpacity = Math.max(0, 1 - (scrollY / 200)).toString();
    if (greeting) greeting.style.opacity = fadeOpacity;
    if (label) label.style.opacity = fadeOpacity;
    if (tags) tags.style.opacity = fadeOpacity;

    // 3. Keep the Name and "3rd year" text completely fixed
    // UNTIL a certain scroll threshold is reached, then push it upwards.
    const scrollThreshold = height * 0.4; // Start pushing up much earlier
    if (stickyGroup) {
      if (scrollY > scrollThreshold) {
        // Push the text up at the same speed as the user scrolls
        const pushUpAmount = scrollY - scrollThreshold;
        
        // Calculate the maximum we can push it up before it hits the top border (1rem = 16px)
        // Let's leave 2rem (32px) padding from the top
        const heroRect = stickyGroup.parentElement.getBoundingClientRect();
        // Since parent (.hero-content) has a fixed top (35%), we calculate distance from top
        const initialTop = (height * 0.35) - (heroRect.height / 2);
        
        // Max push up is the distance from initial top to the 32px padding
        const maxPushUp = Math.max(0, initialTop - 32);
        
        // Clamp the upward movement so it never crosses the white border
        const clampedPushUp = Math.min(pushUpAmount, maxPushUp);
        
        stickyGroup.style.transform = `translateY(-${clampedPushUp}px)`;
      } else {
        stickyGroup.style.transform = `translateY(0px)`;
      }
    }

    // Shader and Background fades
    if (fuji) {
      const opacity = Math.max(0, 1 - (scrollY / (height * 0.6)));
      fuji.style.opacity = opacity.toString();
    }
    if (bg) {
      const blurAmount = Math.min(15, scrollY / 40);
      bg.style.filter = `blur(${blurAmount}px) brightness(${Math.max(0.2, 1 - scrollY/800)})`;
    }
  });

  // Custom smooth scroll function for butter-smooth button click
  function customSmoothScroll(targetPosition, duration) {
    const startPosition = window.scrollY;
    const distance = targetPosition - startPosition;
    let startTime = null;

    function animation(currentTime) {
      if (startTime === null) startTime = currentTime;
      const timeElapsed = currentTime - startTime;
      const progress = Math.min(timeElapsed / duration, 1);
      
      // Easing function (easeInOutCubic)
      const ease = progress < 0.5 
        ? 4 * progress * progress * progress 
        : 1 - Math.pow(-2 * progress + 2, 3) / 2;

      window.scrollTo(0, startPosition + distance * ease);

      if (timeElapsed < duration) {
        requestAnimationFrame(animation);
      }
    }
    requestAnimationFrame(animation);
  }

  // Auto-scroll logic via wheel event
  let isAutoScrolling = false;
  
  window.addEventListener('wheel', (e) => {
    if (isAutoScrolling) {
      e.preventDefault();
      return;
    }

    const scrollY = window.scrollY;
    const maxScroll = document.body.scrollHeight - window.innerHeight;
    const scrollingDown = e.deltaY > 0;

    // If at the top and scrolling down
    if (scrollingDown && scrollY < 50) {
      e.preventDefault();
      isAutoScrolling = true;
      customSmoothScroll(maxScroll, 1000);
      setTimeout(() => { isAutoScrolling = false; }, 1200);
    }
    // If at the bottom and scrolling up
    else if (!scrollingDown && scrollY > maxScroll - 50) {
      e.preventDefault();
      isAutoScrolling = true;
      customSmoothScroll(0, 1000);
      setTimeout(() => { isAutoScrolling = false; }, 1200);
    }
  }, { passive: false });

  // Smooth scroll for the down arrow
  document.getElementById('scroll-down-btn')?.addEventListener('click', (e) => {
    e.preventDefault();
    if (isAutoScrolling) return;
    isAutoScrolling = true;
    customSmoothScroll(document.body.scrollHeight - window.innerHeight, 1000);
    setTimeout(() => { isAutoScrolling = false; }, 1200);
  });
</script>

<style>
  html {
    /* No scroll-snap, we handle it via JS now to avoid pulling bugs */
  }

  .home-viewport {
    position: fixed;
    inset: 0;
    z-index: 20;
    overflow: hidden;
    pointer-events: none;
  }

  .home-viewport > * {
    pointer-events: auto;
  }

  /* --- Bird figure — bleeds out of top-right corner --- */
  .hero-figure {
    position: absolute;
    top: -2%;
    right: -2%;
    width: clamp(220px, 22vw, 380px);
    height: auto;
    object-fit: contain;
    z-index: 1;
    filter: grayscale(0.2);
    opacity: 0.85;
    pointer-events: none;
    user-select: none;
  }

  /* --- Hero text — left-center area --- */
  .hero-content {
    position: absolute;
    left: 8%;
    top: 35%; /* A bit on top */
    transform: translateY(-50%);
    z-index: 2;
  }

  .hero-greeting {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 500;
    color: #D4C594; /* Phosphor Amber */
    margin: 0 0 0.2rem 0;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .hero-label {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 500;
    color: #D4C594;
    opacity: 0.8;
    margin: 0 0 0.2rem 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-name {
    font-family: 'EB Garamond', serif;
    font-size: 5rem;
    font-weight: 500;
    color: #FFFFFF;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin: 0;
  }

  .hero-subtitle {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(212, 197, 148, 0.7); /* #D4C594 at 70% opacity */
    margin: 1.2rem 0 0 0;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero-subtitle .highlight {
    color: #FFF3C7;
    font-weight: 600;
  }

  .hero-tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.2rem 0 0 0;
  }

  .hero-tags .tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: #D4C594;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 0.35rem 0.6rem 0.3rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-tags .tag-dot {
    display: flex;
    align-items: center;
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.8rem;
    line-height: 1;
  }

  /* --- Scroll Indicator --- */
  .scroll-indicator {
    position: absolute;
    bottom: 3rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
    color: #D4C594;
    opacity: 0.7;
    transition: opacity 0.3s ease;
    text-decoration: none;
    z-index: 10;
  }

  .scroll-indicator:hover {
    opacity: 1;
  }

  .scroll-text {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0;
    white-space: nowrap;
  }

  .scroll-arrow {
    width: 1.25rem;
    height: 1.25rem;
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(25%); }
  }

  /* --- Mobile --- */
  @media (max-width: 768px) {
    .hero-figure {
      width: 160px;
      top: -1%;
      right: -3%;
    }

    .hero-content {
      left: 6%;
      top: 35%; /* A bit on top */
    }

    .hero-greeting {
      font-size: var(--text-2xl);
    }

    .hero-name {
      font-size: var(--text-3xl);
    }
  }
</style>
