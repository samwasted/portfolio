              </div>

              <div class="inline-flex items-center link-group group w-fit">
                &nbsp;&nbsp;&nbsp;├──&nbsp;<a
                  href="https://codeforces.com/profile/aceclofenac"
                  target="_blank"
                  class="cyan-text magenta-hover transition-colors underline underline-offset-4 ml-1"
