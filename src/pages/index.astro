---
/**
 * Main page — Single viewport landing with hero + nav.
 * Projects, Editorials, Contact are separate pages.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ShaderBackground from '../components/ShaderBackground.astro';
import Nav from '../components/Nav.astro';
import FujiShaderOverlay from '../components/FujiShaderOverlay.astro';
---

<BaseLayout title="Samarpan Verma — Portfolio">
  <ShaderBackground />
  <FujiShaderOverlay />
  <div class="page-frame" aria-hidden="true"></div>
  <Nav />

  <!-- Hero Section (Vanilla CSS) -->
  <div class="home-viewport">
    <main class="hero-content">
      <h1 class="hero-greeting">Hi there!</h1>
      <p class="hero-label">I am</p>
      <h2 class="hero-name">Samarpan Verma</h2>
      <p class="hero-subtitle">3rd year <span class="highlight">Mathematics &amp; Computing</span> student at <span class="highlight">IIT (BHU) Varanasi</span></p>
      <div class="hero-tags">
        <span class="tag">C++</span>
        <span class="tag-dot">&bull;</span>
        <span class="tag">Systems</span>
        <span class="tag-dot">&bull;</span>
        <span class="tag">Algorithms</span>
      </div>
    </main>

    <!-- Scroll Down Icon -->
    <a href="#about" id="scroll-down-btn" class="scroll-indicator" aria-label="Scroll to About Me">
      <span class="scroll-text">More About Me</span>
      <svg class="scroll-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
    </a>
  </div>

  <!-- About Section (Tailwind CSS) -->
  <section id="about" class="min-h-screen w-full relative bg-[#0a0a0a]/95 backdrop-blur-md px-8 md:px-16 lg:px-[12%] xl:px-[15%] py-24 flex items-center z-20 border-t border-white/10">
    <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      
      <div class="lg:col-span-8 space-y-16">
        <!-- Typography play -->
        <div>
          <h2 class="text-[#D4C594] font-mono text-sm tracking-[0.2em] uppercase mb-6 flex items-center gap-4">
            <span class="w-12 h-px bg-[#D4C594]/50"></span>
            About Me
          </h2>
          <h3 class="text-white font-display text-5xl md:text-7xl font-medium leading-[1.1] mb-8">
            Samarpan Verma
          </h3>
          <p class="text-white/80 font-sans text-lg md:text-xl leading-relaxed max-w-2xl">
            3rd year <span class="text-[#FFF3C7] font-semibold">Mathematics & Computing</span> student at <span class="text-[#FFF3C7] font-semibold">IIT (BHU) Varanasi</span>.
          </p>
          <p class="text-white/80 font-sans text-lg md:text-xl leading-relaxed mt-4">
            Competitive Programmer &mdash; <a href="https://codeforces.com/" target="_blank" class="text-[#D4C594] hover:text-[#FFF3C7] underline decoration-[#D4C594]/30 hover:decoration-[#FFF3C7] underline-offset-4 transition-all">Codeforces Account</a>
          </p>
        </div>

        <!-- Achievements & Recent Work -->
        <div class="space-y-8">
          <h4 class="text-[#D4C594] font-mono text-xs tracking-[0.15em] uppercase border-b border-white/10 pb-4">Achievements & Recent Work</h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <a href="/projects" class="group block p-8 border border-white/10 hover:border-[#D4C594]/50 bg-white/[0.02] hover:bg-[#D4C594]/5 transition-all duration-500 relative overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-br from-[#D4C594]/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <h5 class="text-white font-serif text-2xl mb-3 group-hover:text-[#FFF3C7] transition-colors relative z-10">Projects</h5>
              <p class="text-white/50 font-sans text-sm leading-relaxed relative z-10">View my latest technical builds, systems engineering work, and algorithmic implementations.</p>
              <div class="mt-6 flex items-center text-[#D4C594] font-mono text-xs uppercase tracking-widest opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition-all duration-300">
                Explore <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
              </div>
            </a>
            <a href="/editorials" class="group block p-8 border border-white/10 hover:border-[#D4C594]/50 bg-white/[0.02] hover:bg-[#D4C594]/5 transition-all duration-500 relative overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-br from-[#D4C594]/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <h5 class="text-white font-serif text-2xl mb-3 group-hover:text-[#FFF3C7] transition-colors relative z-10">Editorials</h5>
              <p class="text-white/50 font-sans text-sm leading-relaxed relative z-10">Read my deep dives into algorithms, competitive programming concepts, and computer vision.</p>
              <div class="mt-6 flex items-center text-[#D4C594] font-mono text-xs uppercase tracking-widest opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition-all duration-300">
                Read More <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
              </div>
            </a>
          </div>
        </div>

        <!-- Resume Download -->
        <div class="pt-12 border-t border-white/10">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 bg-white/[0.02] p-8 border border-white/5">
            <div>
              <h4 class="text-white font-serif text-2xl mb-2">Still prefer PDFs?</h4>
              <p class="text-white/50 font-sans text-sm">Download my formal resume for a traditional overview.</p>
            </div>
            <a href="/resume.pdf" target="_blank" class="shrink-0 inline-flex items-center px-6 py-4 border border-[#D4C594]/40 text-[#D4C594] font-mono text-xs uppercase tracking-[0.15em] hover:bg-[#D4C594] hover:text-[#0a0a0a] transition-all duration-300 group">
              Download Resume
              <svg class="w-4 h-4 ml-3 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Timeline on the right -->
      <div class="lg:col-span-4 lg:pl-12 pt-4">
        <div class="sticky top-24 border-l border-white/10 pl-8 space-y-12">
          <h4 class="text-[#D4C594] font-mono text-xs tracking-[0.15em] uppercase mb-8 flex items-center">
            Timeline
          </h4>
          
          <div class="relative group">
            <div class="absolute w-2 h-2 bg-[#D4C594] rounded-full -left-[37px] top-1.5 shadow-[0_0_15px_rgba(212,197,148,0.6)] group-hover:scale-125 transition-transform duration-300"></div>
            <p class="text-[#FFF3C7] font-mono text-xs mb-2 tracking-widest uppercase">Present</p>
            <h5 class="text-white font-serif text-xl mb-1">IIT (BHU) Varanasi</h5>
            <p class="text-white/60 font-sans text-sm leading-relaxed">Pursuing B.Tech in Mathematics & Computing.</p>
          </div>

          <div class="relative opacity-60 hover:opacity-100 transition-opacity duration-300 group">
            <div class="absolute w-2 h-2 bg-white/40 rounded-full -left-[36px] top-1.5 group-hover:bg-white/80 transition-colors"></div>
            <p class="text-white/50 font-mono text-xs mb-2 tracking-widest uppercase group-hover:text-white/80 transition-colors">2021</p>
            <h5 class="text-white font-serif text-lg mb-1">High School</h5>
            <p class="text-white/50 font-sans text-sm leading-relaxed group-hover:text-white/70 transition-colors">Started coding competitively and exploring systems programming.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Fade out Fuji shader and blur background based on scroll
  const fuji = document.getElementById('fuji-shader-overlay');
  const bg = document.getElementById('image-bg');
  
  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;
    const height = window.innerHeight;
    
    if (fuji) {
      // Fade out completely by the time we scroll 80% of a screen
      const opacity = Math.max(0, 1 - (scrollY / (height * 0.8)));
      fuji.style.opacity = opacity.toString();
    }
    
    if (bg) {
      // Add a slight blur effect to the background image as we scroll down
      const blurAmount = Math.min(10, scrollY / 50);
      bg.style.filter = `blur(${blurAmount}px) brightness(${Math.max(0.3, 1 - scrollY/1000)})`;
    }
  });

  // Smooth scroll for the down arrow
  document.getElementById('scroll-down-btn')?.addEventListener('click', (e) => {
    e.preventDefault();
    const aboutSection = document.getElementById('about');
    if (aboutSection) {
      window.scrollTo({
        top: aboutSection.offsetTop,
        behavior: 'smooth'
      });
    }
  });
</script>

<style>
  /* Scroll behavior for the whole page */
  html {
    scroll-behavior: smooth;
  }

  .home-viewport {
    position: relative;
    width: 100%;
    height: 100vh;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
  }

  .home-viewport > * {
    pointer-events: auto;
  }

  /* --- Bird figure — bleeds out of top-right corner --- */
  .hero-figure {
    position: absolute;
    top: -2%;
    right: -2%;
    width: clamp(220px, 22vw, 380px);
    height: auto;
    object-fit: contain;
    z-index: 1;
    filter: grayscale(0.2);
    opacity: 0.85;
    pointer-events: none;
    user-select: none;
  }

  /* --- Hero text — left-center area --- */
  .hero-content {
    position: absolute;
    left: 8%;
    top: 35%; /* A bit on top */
    transform: translateY(-50%);
    z-index: 2;
  }

  .hero-greeting {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 500;
    color: #D4C594; /* Phosphor Amber */
    margin: 0 0 0.2rem 0;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .hero-label {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 500;
    color: #D4C594;
    opacity: 0.8;
    margin: 0 0 0.2rem 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-name {
    font-family: 'EB Garamond', serif;
    font-size: 5rem;
    font-weight: 500;
    color: #FFFFFF;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin: 0;
  }

  .hero-subtitle {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(212, 197, 148, 0.7); /* #D4C594 at 70% opacity */
    margin: 1.2rem 0 0 0;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero-subtitle .highlight {
    color: #FFF3C7;
    font-weight: 600;
  }

  .hero-tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.2rem 0 0 0;
  }

  .hero-tags .tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: #D4C594;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 0.35rem 0.6rem 0.3rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-tags .tag-dot {
    display: flex;
    align-items: center;
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.8rem;
    line-height: 1;
  }

  /* --- Scroll Indicator --- */
  .scroll-indicator {
    position: absolute;
    bottom: 3rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    color: #D4C594;
    opacity: 0.7;
    transition: opacity 0.3s ease;
    text-decoration: none;
    z-index: 10;
  }

  .scroll-indicator:hover {
    opacity: 1;
  }

  .scroll-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .scroll-arrow {
    width: 1.5rem;
    height: 1.5rem;
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(25%); }
  }

  /* --- Mobile --- */
  @media (max-width: 768px) {
    .hero-figure {
      width: 160px;
      top: -1%;
      right: -3%;
    }

    .hero-content {
      left: 6%;
      top: 35%; /* A bit on top */
    }

    .hero-greeting {
      font-size: var(--text-2xl);
    }

    .hero-name {
      font-size: var(--text-3xl);
    }
  }
</style>
