---
/**
 * Main page — Single viewport landing with hero + nav.
 * Projects, Editorials, Contact are separate pages.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ShaderBackground from '../components/ShaderBackground.astro';
import Nav from '../components/Nav.astro';
import FujiShaderOverlay from '../components/FujiShaderOverlay.astro';
---

<BaseLayout title="Samarpan Verma — Portfolio">
  <ShaderBackground />
  <FujiShaderOverlay />
  <div class="page-frame" aria-hidden="true"></div>
  <Nav />

  <!-- Hero Section (Vanilla CSS) -->
  <!-- Hero Section (Fixed in place) -->
  <div class="home-viewport">
    <main class="hero-content">
      <h1 id="hero-greeting" class="hero-greeting transition-opacity duration-300">Hi there!</h1>
      <p id="hero-label" class="hero-label transition-opacity duration-300">I am</p>
      <div id="hero-sticky-group" class="transition-transform duration-[0ms] ease-linear">
        <h2 class="hero-name">Samarpan Verma</h2>
        <p class="hero-subtitle">3rd year <span class="highlight">Mathematics &amp; Computing</span> student at <span class="highlight">IIT (BHU) Varanasi</span></p>
      </div>
      <div id="hero-tags" class="hero-tags transition-opacity duration-300">
        <span class="tag">C++</span>
        <span class="tag-dot">&bull;</span>
        <span class="tag">Systems</span>
        <span class="tag-dot">&bull;</span>
        <span class="tag">Algorithms</span>
      </div>
    </main>

    <!-- Scroll Down Icon (will fade out on scroll) -->
    <div id="scroll-indicator-container" class="absolute bottom-12 left-1/2 -translate-x-1/2 transition-opacity duration-300">
      <a href="#about" id="scroll-down-btn" class="scroll-indicator" aria-label="Scroll to About Me">
        <svg class="scroll-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
        <span class="scroll-text">More About Me</span>
      </a>
    </div>
  </div>

  <!-- Spacer to push the scroll content down by one screen height -->
  <div class="h-[100vh] w-full relative z-0 pointer-events-none"></div>

  <!-- About Section (Scrolls up) -->
  <section id="about" class="min-h-screen w-full relative z-30 flex items-center bg-gradient-to-b from-transparent via-[#0a0a0a]/60 to-[#0a0a0a]/85" style="padding: 15vh 12vw 15vh 8vw;">
    <div class="w-full h-full">
      <!-- Full Width Grid Layout -->
      <div class="w-full h-full grid grid-cols-1 lg:grid-cols-12 gap-x-12 text-white">
        
        <!-- PANE 1: Chronological Event Ledger (Left Side, Centered) -->
        <div class="lg:col-span-6 flex flex-col justify-center space-y-8 text-lg">
          <div class="text-[#D4C594] font-mono text-sm tracking-widest uppercase border-b border-white/10 pb-4">
            System Log // Event Ledger
          </div>
          
          <div class="font-mono text-base space-y-5 text-white/60">
            <div class="flex gap-4 group">
              <div class="text-[#D4C594] whitespace-nowrap min-w-[110px] opacity-80 group-hover:opacity-100 transition-opacity">[RANK] 2026-04</div>
              <div class="text-white/20 select-none">|</div>
              <div class="text-white/90 leading-relaxed">Codeforces Expert Rank profile validation.</div>
            </div>
            
            <div class="flex gap-4 group">
              <div class="text-[#D4C594] whitespace-nowrap min-w-[110px] opacity-80 group-hover:opacity-100 transition-opacity">[AWARD] 2026-03</div>
              <div class="text-white/20 select-none">|</div>
              <div class="text-white/90 leading-relaxed">Bronze Medal at Inter IIT Tech Meet 14.0 (Quant Problem Statement).</div>
            </div>

            <div class="flex gap-4 group">
              <div class="text-[#FFF3C7] whitespace-nowrap min-w-[110px] opacity-80 group-hover:opacity-100 transition-opacity">[LAUNCH] 2026-03</div>
              <div class="text-white/20 select-none">|</div>
              <div class="text-white/90 leading-relaxed">"Rent-a-Romeo" Matchmaking Engine deployment trace.</div>
            </div>

            <div class="flex gap-4 group">
              <div class="text-[#FFF3C7] whitespace-nowrap min-w-[110px] opacity-80 group-hover:opacity-100 transition-opacity">[LAUNCH] 2026-01</div>
              <div class="text-white/20 select-none">|</div>
              <div class="text-white/90 leading-relaxed">"jailsh" Unix Sandbox Runtime kernel implementation logs (seccomp-BPF, namespaces).</div>
            </div>
          </div>
        </div>

        <!-- Right Panes 2 & 3 (Top Right & Bottom Right) -->
        <div class="lg:col-span-4 lg:col-start-9 flex flex-col space-y-24 lg:space-y-32 h-full">
          
          <!-- PANE 2: Environment Dependencies & Registries (Top Right) -->
          <div class="space-y-6 pt-4">
            <div class="text-[#D4C594] font-mono text-sm tracking-widest uppercase border-b border-white/10 pb-4">
              Environment & Registries
            </div>
            
            <div class="font-mono text-base text-white/30 leading-loose flex flex-col">
              <div>.</div>
              <div>├── <span class="text-[#D4C594]/80">bin/</span></div>
              
              <div>│&nbsp;&nbsp;├── <span class="text-white">cpp17</span> <span class="text-[#D4C594]/50 text-sm ml-2">#define int ll</span></div>
              <div>│&nbsp;&nbsp;├── <span class="text-white">python3</span></div>
              <div>│&nbsp;&nbsp;└── <span class="text-white">glsl</span></div>
              
              <div>├── <span class="text-[#D4C594]/80">sys/</span></div>
              
              <div>│&nbsp;&nbsp;├── <span class="text-white">seccomp-bpf</span></div>
              <div>│&nbsp;&nbsp;└── <span class="text-white">linux_namespaces</span></div>
              
              <div>└── <span class="text-[#D4C594]/80">remote/</span> <span class="text-[#D4C594]/50 text-sm ml-2"># hyperlinks btw</span></div>
              
              <div class="inline-flex items-center link-group group w-fit">&nbsp;&nbsp;&nbsp;├── <a href="https://codeforces.com/profile/amwasted" target="_blank" class="text-white magenta-hover transition-colors underline decoration-white/20 underline-offset-4 ml-1">cf/amwasted</a><svg class="w-4 h-4 ml-2 text-[#FF00FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path class="flower-petal" pathLength="100" d="M12 16 C8 16 2 12 4 8 C8 6 12 12 12 16 M12 16 C16 16 22 12 20 8 C16 6 12 12 12 16" /></svg></div>
              
              <div class="inline-flex items-center link-group group w-fit">&nbsp;&nbsp;&nbsp;├── <a href="https://leetcode.com/" target="_blank" class="text-white magenta-hover transition-colors underline decoration-white/20 underline-offset-4 ml-1">leetcode</a><svg class="w-4 h-4 ml-2 text-[#FF00FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path class="flower-petal" pathLength="100" d="M12 16 C8 16 2 12 4 8 C8 6 12 12 12 16 M12 16 C16 16 22 12 20 8 C16 6 12 12 12 16" /></svg></div>
              
              <div class="inline-flex items-center link-group group w-fit">&nbsp;&nbsp;&nbsp;├── <a href="https://github.com/samwasted" target="_blank" class="text-white magenta-hover transition-colors underline decoration-white/20 underline-offset-4 ml-1">gh/samwasted</a><svg class="w-4 h-4 ml-2 text-[#FF00FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path class="flower-petal" pathLength="100" d="M12 16 C8 16 2 12 4 8 C8 6 12 12 12 16 M12 16 C16 16 22 12 20 8 C16 6 12 12 12 16" /></svg></div>
              
              <div class="inline-flex items-center link-group group w-fit">&nbsp;&nbsp;&nbsp;└── <a href="#" class="text-white/50 magenta-hover transition-colors italic ml-1">arxiv_index</a><svg class="w-4 h-4 ml-2 text-[#FF00FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path class="flower-petal" pathLength="100" d="M12 16 C8 16 2 12 4 8 C8 6 12 12 12 16 M12 16 C16 16 22 12 20 8 C16 6 12 12 12 16" /></svg></div>
            </div>
          </div>

          <!-- PANE 3: System Egress Protocols (Bottom Right) -->
          <div class="space-y-6 pb-4" style="margin-top: 8rem;">
            <div class="text-[#D4C594] font-mono text-sm tracking-widest uppercase border-b border-white/10 pb-4">
              System Egress
            </div>
            
            <div class="font-mono text-base space-y-6">
              <!-- Contact -->
              <a href="mailto:samarpan.verma.mat24@itbhu.ac.in" class="block group cursor-pointer">
                <span class="text-[#D4C594] group-hover:text-white transition-colors">> [ initiate_remote_protocol<span class="opacity-0 group-hover:opacity-100 text-white inline-block w-2 ml-1">_</span> ]</span> <span class="text-[#D4C594]/50 text-sm ml-2"># mail me</span>
                <div class="pl-4 text-white/40 text-sm mt-2 border-l border-white/10 ml-2">
                  <span class="opacity-50">email:</span> samarpan.verma.mat24@itbhu.ac.in
                </div>
              </a>

              <!-- Resume -->
              <a href="/resume.pdf" target="_blank" class="block group cursor-pointer">
                <span class="text-[#D4C594] group-hover:text-white transition-colors">> [ download_legacy_resume.pdf<span class="opacity-0 group-hover:opacity-100 text-white inline-block w-2 ml-1">_</span> ]</span>
                <div class="pl-4 text-white/40 text-sm mt-2 border-l border-white/10 ml-2 flex flex-col space-y-1">
                  <div><span class="opacity-50">size:</span> 142 KB</div>
                  <div><span class="opacity-50">type:</span> application/pdf</div>
                  <div><span class="opacity-50">md5:&nbsp;</span> 8f4e2c9b1a0d3e5f</div>
                </div>
              </a>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Fade out Fuji shader, blur background, and hide scroll arrow based on scroll
  const fuji = document.getElementById('fuji-shader-overlay');
  const bg = document.getElementById('image-bg');
  const indicator = document.getElementById('scroll-indicator-container');
  
  // Hero text elements
  const greeting = document.getElementById('hero-greeting');
  const label = document.getElementById('hero-label');
  const tags = document.getElementById('hero-tags');
  const stickyGroup = document.getElementById('hero-sticky-group');
  const homeViewport = document.querySelector('.home-viewport');
  
  let isTicking = false;
  window.addEventListener('scroll', () => {
    if (!isTicking) {
      window.requestAnimationFrame(() => {
        const scrollY = window.scrollY;
        const height = window.innerHeight;
        
        // 1. Hide scroll indicator
        if (indicator) {
          indicator.style.opacity = scrollY > 50 ? '0' : '1';
          indicator.style.pointerEvents = scrollY > 50 ? 'none' : 'auto';
        }

        // 2. Fade out secondary text (greeting, label, tags) in the first 200px of scrolling
        const fadeOpacity = Math.max(0, 1 - (scrollY / 200)).toString();
        if (greeting) greeting.style.opacity = fadeOpacity;
        if (label) label.style.opacity = fadeOpacity;
        if (tags) tags.style.opacity = fadeOpacity;

        // 3. Keep the Name and "3rd year" text completely fixed
        const scrollThreshold = height * 0.4;
        if (stickyGroup) {
          if (scrollY > scrollThreshold) {
            const pushUpAmount = scrollY - scrollThreshold;
            if (stickyGroup.parentElement) {
              const heroRect = stickyGroup.parentElement.getBoundingClientRect();
              const initialTop = (height * 0.35) - (heroRect.height / 2);
              const maxPushUp = Math.max(0, initialTop - 32); // 32px padding from top
              const clampedPushUp = Math.min(pushUpAmount, maxPushUp);
              
              stickyGroup.style.transform = `translateY(-${clampedPushUp}px)`;
              stickyGroup.style.opacity = '1';
            }
          } else {
            stickyGroup.style.transform = `translateY(0px)`;
            stickyGroup.style.opacity = '1';
          }
        }

        // Shader and Background fades
        if (fuji) {
          const opacity = Math.max(0.3, 1 - (scrollY / (height * 0.6)));
          fuji.style.opacity = opacity.toString();
        }
        if (bg) {
          bg.style.filter = `brightness(${Math.max(0.2, 1 - scrollY/800)})`;
        }
        
        isTicking = false;
      });
      isTicking = true;
    }
  });

  // Custom smooth scroll function for butter-smooth button click
  function customSmoothScroll(targetPosition, duration) {
    const startPosition = window.scrollY;
    const distance = targetPosition - startPosition;
    let startTime = null;

    function animation(currentTime) {
      if (startTime === null) startTime = currentTime;
      const timeElapsed = currentTime - startTime;
      const progress = Math.min(timeElapsed / duration, 1);
      
      // Easing function (easeInOutCubic)
      const ease = progress < 0.5 
        ? 4 * progress * progress * progress 
        : 1 - Math.pow(-2 * progress + 2, 3) / 2;

      window.scrollTo(0, startPosition + distance * ease);

      if (timeElapsed < duration) {
        requestAnimationFrame(animation);
      }
    }
    requestAnimationFrame(animation);
  }

  // Auto-scroll logic via wheel event
  let isAutoScrolling = false;
  
  window.addEventListener('wheel', (e) => {
    if (isAutoScrolling) {
      e.preventDefault();
      return;
    }

    const scrollY = window.scrollY;
    const maxScroll = document.body.scrollHeight - window.innerHeight;
    const scrollingDown = e.deltaY > 0;

    // If at the top and scrolling down
    if (scrollingDown && scrollY < 50) {
      e.preventDefault();
      isAutoScrolling = true;
      customSmoothScroll(maxScroll, 1000);
      setTimeout(() => { isAutoScrolling = false; }, 1200);
    }
    // If at the bottom and scrolling up
    else if (!scrollingDown && scrollY > maxScroll - 50) {
      e.preventDefault();
      isAutoScrolling = true;
      customSmoothScroll(0, 1000);
      setTimeout(() => { isAutoScrolling = false; }, 1200);
    }
  }, { passive: false });

  // Use event delegation in the CAPTURE phase so listeners intercept the click
  // BEFORE Astro's ViewTransitions router can see it and trigger a reload.
  document.addEventListener('click', (e) => {
    const target = e.target;
    if (!target || typeof target.closest !== 'function') return;
    
    // Smooth scroll for the down arrow
    if (target.closest('#scroll-down-btn')) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      
      if (isAutoScrolling) return;
      isAutoScrolling = true;
      customSmoothScroll(document.body.scrollHeight - window.innerHeight, 1000);
      setTimeout(() => { isAutoScrolling = false; }, 1200);
      return;
    }

    // Toggle scroll for the "About me" nav link
    if (target.closest('#nav-about-link')) {
      // If we are on the home page, intercept the click and scroll
      if (window.location.pathname === '/') {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        
        if (isAutoScrolling) return;
        
        const maxScroll = document.body.scrollHeight - window.innerHeight;
        isAutoScrolling = true;
        
        // If we're at the top, scroll down to About. If we're at the bottom, scroll up to Home.
        if (window.scrollY < maxScroll / 2) {
          customSmoothScroll(maxScroll, 1000);
        } else {
          customSmoothScroll(0, 1000);
        }
        
        setTimeout(() => { isAutoScrolling = false; }, 1200);
      }
    }
  }, { capture: true });
</script>

<style>
  html {
    /* No scroll-snap, we handle it via JS now to avoid pulling bugs */
  }

  .home-viewport {
    position: fixed;
    inset: 0;
    z-index: 40;
    overflow: hidden;
    pointer-events: none;
  }

  .home-viewport > * {
    pointer-events: auto;
  }

  /* --- Bird figure — bleeds out of top-right corner --- */
  .hero-figure {
    position: absolute;
    top: -2%;
    right: -2%;
    width: clamp(220px, 22vw, 380px);
    height: auto;
    object-fit: contain;
    z-index: 1;
    filter: grayscale(0.2);
    opacity: 0.85;
    pointer-events: none;
    user-select: none;
  }

  /* --- Hero text — left-center area --- */
  .hero-content {
    position: absolute;
    left: 8vw;
    top: 35%; /* A bit on top */
    transform: translateY(-50%);
    z-index: 2;
  }

  .hero-greeting {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 500;
    color: #D4C594; /* Phosphor Amber */
    margin: 0 0 0.2rem 0;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .hero-label {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 500;
    color: #D4C594;
    opacity: 0.8;
    margin: 0 0 0.2rem 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-name {
    font-family: 'EB Garamond', serif;
    font-size: 5rem;
    font-weight: 500;
    color: #FFFFFF;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin: 0;
  }

  .hero-subtitle {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(212, 197, 148, 0.7); /* #D4C594 at 70% opacity */
    margin: 1.2rem 0 0 0;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero-subtitle .highlight {
    color: #FFF3C7;
    font-weight: 600;
  }

  .hero-tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.2rem 0 0 0;
  }

  .hero-tags .tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: #D4C594;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 0.35rem 0.6rem 0.3rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-tags .tag-dot {
    display: flex;
    align-items: center;
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.8rem;
    line-height: 1;
  }

  /* --- Scroll Indicator --- */
  .scroll-indicator {
    position: absolute;
    bottom: 3rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
    color: #D4C594;
    opacity: 0.7;
    transition: opacity 0.3s ease;
    text-decoration: none;
    z-index: 10;
  }

  .scroll-indicator:hover {
    opacity: 1;
  }

  .scroll-text {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0;
    white-space: nowrap;
  }

  .scroll-arrow {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* --- Mobile --- */
  @media (max-width: 768px) {
    .hero-figure {
      width: 160px;
      top: -1%;
      right: -3%;
    }

    .hero-content {
      left: 6%;
      top: 35%; /* A bit on top */
    }

    .hero-greeting {
      font-size: var(--text-2xl);
    }

    .hero-name {
      font-size: var(--text-3xl);
    }
  }

  /* --- Flower Petal Unfurling Effect --- */
  .flower-petal {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 1.2s ease-out;
  }

  .link-group:hover .flower-petal {
    stroke-dashoffset: 0;
  }

  /* Force magenta hover color, bypassing Tailwind arbitrary values */
  .link-group:hover .magenta-hover {
    color: #FF00FF !important;
  }
</style>
