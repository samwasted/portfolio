---
/**
 * Main page — All sections composed together.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ShaderBackground from '../components/ShaderBackground.astro';
import ShaderBackground2 from '../components/ShaderBackground2.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import Editorials from '../components/Editorials.astro';
import Contact from '../components/Contact.astro';
---

<BaseLayout title="Samarpan Verma — Portfolio">
  <ShaderBackground />
  <Nav active="about" />
  <div class="page-frame" aria-hidden="true"></div>

  <main>
    <Hero />
    <Projects />
    <Editorials />
    <Contact />
  </main>
</BaseLayout>

<style>
  main {
    position: relative;
    z-index: 1;
  }
</style>
