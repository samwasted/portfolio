            </div>

            <div
              class="font-mono text-base text-white/30 leading-loose flex flex-col"
            >
              <div>├── <span class="text-[#D4C594]/80">stack/</span></div>

              <div>
                │&nbsp;&nbsp;├── <span class="text-white">cpp17</span>
                <span class="text-[#D4C594]/50 text-sm ml-2"
                  >#define int ll</span>
              </div>
