                ><svg
                  class="w-4 h-4 ml-2 text-[#FF00FF]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path
                    class="flower-petal"
                    pathLength="100"
                    d="M12 16 C8 16 2 12 4 8 C8 6 12 12 12 16 M12 16 C16 16 22 12 20 8 C16 6 12 12 12 16"
                  ></path></svg>
