              </div>
            </div>

            <!-- [CORE] Highlight -->
            <div class="flex gap-4 group items-start relative z-10">
              <div class="text-[#FFF3C7] whitespace-nowrap w-[155px] flex-shrink-0 text-left md:text-right drop-shadow-[0_0_8px_rgba(255,255,255,0.8)] transition-opacity">
                [CORE] 2026-04
              </div>
              <div class="flex-col items-center justify-start w-[10px] flex-shrink-0 hidden md:flex" style="transform: translateY(10px);">
                <div class="w-2 h-2 rounded-full bg-white shadow-[0_0_10px_rgba(255,255,255,0.8),0_0_20px_rgba(255,255,255,0.4)]"></div>
              </div>
              <div class="text-white/60 select-none md:hidden flex-shrink-0">|</div>
              <div class="text-white leading-relaxed font-medium drop-shadow-[0_0_8px_rgba(255,255,255,0.4)] flex-1">
                "jailsh" C++17 interactive execution sandbox and container runtime. Engineered a strict double-fork PID 1 init model, IPC handshakes, and cgroups v2 boundaries.
              </div>
            </div>
          </div>
        </div>

        <!-- Right Panes 2 & 3 (Top Right & Bottom Right) -->
        <div
          class="lg:col-span-4 lg:col-start-9 flex flex-col h-full mt-24 lg:mt-0 gap-5"
        >
          <!-- PANE 2: Environment Dependencies & Registries (Top Right) -->
          <div class="flex flex-col gap-6 pt-4 lg:pt-0">
            <div
              class="text-[#D4C594] font-mono text-sm tracking-widest uppercase border-b border-white/10 pb-4"
