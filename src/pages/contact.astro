---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShaderBackground from '../components/ShaderBackground.astro';
import Nav from '../components/Nav.astro';
import ContactComponent from '../components/Contact.astro';
---

<BaseLayout title="Contact — Samarpan Verma">
  <ShaderBackground />
  <Nav active="contact" showBack={true} />
  <div class="page-frame" aria-hidden="true"></div>

  <main class="page-content">
    <ContactComponent />
  </main>
</BaseLayout>

<style>
  .page-content {
    position: relative;
    z-index: 1;
  }
</style>
