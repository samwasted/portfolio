---
/**
 * Editorials listing page — shows all editorials.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShaderBackground from '../../components/ShaderBackground.astro';
import AboutShaderOverlay from '../../components/AboutShaderOverlay.astro';
import Nav from '../../components/Nav.astro';
import { loadEditorials } from '../../lib/editorial-loader';

const editorials = loadEditorials();

// INJECT DUMMY DATA TO TEST SCROLLABILITY
const dummyEditorials = Array.from({ length: 15 }).map((_, i) => ({
  slug: `dummy-${i}`,
  title: `Scroll Test Article Number ${i + 1}`,
  date: new Date(Date.now() - i * 86400000).toISOString(),
  tags: ['TEST'],
  abstract: 'Just a dummy article for testing scroll bounds.',
}));

const allEditorials = [...editorials, ...dummyEditorials];
---

<BaseLayout title="Editorials - Samarpan Verma" description="Technical editorials and reports" preloadMath={true}>
  <ShaderBackground />
  <Nav active="editorials" showBack />
  <div class="page-frame" aria-hidden="true"></div>

  <main class="editorials-page">
    <AboutShaderOverlay position="top-right" />
    <div class="editorials-page-content">
      <h1 class="page-title">Editorials</h1>
      <p class="page-subtitle">Technical reports and writings</p>

      {allEditorials.length > 0 ? (
        <div class="editorials-list">
          {allEditorials.map(editorial => (
            <a href={`/editorials/${editorial.slug}`} class="editorial-list-item" data-astro-prefetch="hover">
              <span class="card-name">{editorial.title}</span>
              <div class="card-meta">
                {editorial.tags && editorial.tags.length > 0 && (
                  <span class="card-category">{editorial.tags[0]}</span>
                )}
                <span class="card-date">{new Date(editorial.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="editorials-empty">No editorials yet. Check back soon.</p>
      )}
    </div>
  </main>
</BaseLayout>

<style>
  .editorials-page {
    position: fixed;
    top: 1rem;
    left: 1rem;
    width: calc(100% - 2rem);
    height: calc(100vh - 2rem);
    overflow-y: auto;
    z-index: 1;
    padding: 8rem 4rem 4rem 4rem;
    /* Custom scrollbar to keep it sleek inside the frame */
    scrollbar-width: thin;
  }

  .editorials-page-content {
    width: 100%;
    max-width: calc(100% - 10rem);
    margin: 0; /* Align left with strict max width to prevent overlap */
  }

  @media (max-width: 768px) {
    .editorials-page-content {
      max-width: 100%; /* Reset on mobile where navbar is different */
    }
  }

  .page-title {
    font-family: 'EB Garamond', 'Libre Baskerville', serif;
    font-size: 5rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
  }

  .page-subtitle {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-xl);
  }

  .editorials-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-strong);
    margin-top: 2rem;
  }

  .editorial-list-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--border-strong);
    text-decoration: none;
    color: inherit;
    /* Removed global transition:all to prevent layout flinching on page load */
  }

  .editorial-list-item:hover {
    background: transparent;
  }

  .card-name {
    font-family: var(--font-sans);
    font-size: 1.6rem;
    font-weight: 500;
    color: var(--text-secondary); /* Start slightly dimmed */
    transition: color 0.6s ease, text-shadow 0.6s ease, transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .editorial-list-item:hover .card-name {
    color: #ffffff; /* Peak brightness */
    text-shadow: 0 0 16px rgba(255, 255, 255, 0.4), 0 0 32px rgba(255, 255, 255, 0.1); /* Slow blooming glow */
    transform: translateX(10px);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  .card-date,
  .card-category {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .editorials-empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  /* --- Responsive Design --- */
  @media (max-width: 900px) {
    .editorials-page {
      padding: 6rem 2rem 4rem 2rem;
    }
    
    .editorial-list-item {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem 0;
      gap: 1rem;
    }

    .card-name {
      font-size: 1.3rem;
    }

    .editorial-list-item:hover .card-name {
      transform: translateX(5px);
    }

    .card-meta {
      width: 100%;
      justify-content: space-between;
      gap: 0;
    }

    .card-date,
    .card-category {
      font-size: 0.8rem;
    }
  }
</style>
