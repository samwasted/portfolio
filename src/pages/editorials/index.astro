---
/**
 * Editorials listing page — shows all editorials.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShaderBackground from '../../components/ShaderBackground.astro';
import Nav from '../../components/Nav.astro';
import { loadEditorials } from '../../lib/editorial-loader';

const editorials = loadEditorials();
---

<BaseLayout title="Editorials - Samarpan Verma" description="Technical editorials and reports">
  <ShaderBackground />
  <Nav active="editorials" showBack />
  <div class="page-frame" aria-hidden="true"></div>

  <main class="editorials-page">
    <div class="editorials-page-content">
      <h1 class="page-title">Editorials</h1>
      <p class="page-subtitle">Technical reports and writings</p>

      {editorials.length > 0 ? (
        <div class="editorials-list">
          {editorials.map(editorial => (
            <a href={`/editorials/${editorial.slug}`} class="editorial-list-item">
              <div class="editorial-list-meta">
                <time>{editorial.date}</time>
                {editorial.tags.length > 0 && (
                  <div class="editorial-list-tags">
                    {editorial.tags.map(tag => (
                      <span class="editorial-tag">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
              <h2 class="editorial-list-title">{editorial.title}</h2>
              {editorial.abstract && (
                <p class="editorial-list-abstract">{editorial.abstract}</p>
              )}
            </a>
          ))}
        </div>
      ) : (
        <p class="editorials-empty">No editorials yet. Check back soon.</p>
      )}
    </div>
  </main>
</BaseLayout>

<style>
  .editorials-page {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    padding: 6rem var(--page-padding) 4rem;
  }

  .editorials-page-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .page-title {
    font-size: var(--text-2xl);
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
  }

  .page-subtitle {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-xl);
  }

  .editorials-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .editorial-list-item {
    display: block;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
    background: var(--surface);
  }

  .editorial-list-item:hover {
    background: var(--surface-hover);
    border-color: var(--border-strong);
    opacity: 1;
  }

  .editorial-list-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: var(--space-sm);
  }

  .editorial-list-meta time {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .editorial-list-tags {
    display: flex;
    gap: 0.4rem;
  }

  .editorial-tag {
    font-size: 0.65rem;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--border-strong);
    border-radius: 2px;
    color: var(--text-secondary);
    font-family: var(--font-sans);
  }

  .editorial-list-title {
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: var(--space-xs);
    line-height: 1.4;
  }

  .editorial-list-abstract {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .editorials-empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>
