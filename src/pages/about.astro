---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShaderBackground from '../components/ShaderBackground.astro';
import AboutShaderOverlay from '../components/AboutShaderOverlay.astro';
import Nav from '../components/Nav.astro';
import EventLedger from '../components/EventLedger.astro';
---

<BaseLayout title="About - Samarpan Verma">
  <ShaderBackground />
  <AboutShaderOverlay />
  <Nav active="about" showBack={true} />

  <main class="page-content">
    <div class="ledger-container">
      <EventLedger />
    </div>
  </main>
</BaseLayout>

<style>
  .page-content {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 2rem 2rem 2rem; /* Clear nav bar */
  }

  .ledger-container {
    width: 100%;
    max-width: 800px;
    z-index: 10; /* Above the shader */
  }
</style>
