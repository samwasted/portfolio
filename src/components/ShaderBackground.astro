---
/**
 * ShaderBackground — Static background image layer.
 * All WebGL gradient shaders have been removed to save GPU.
 * Film grain is handled by the canvas in BaseLayout.
 */
---

<div id="image-bg" aria-hidden="true" transition:persist="image-bg"></div>

<style>
  #image-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    background-image: url('/bg.png');
    background-size: cover;
    background-position: center;
  }
</style>
