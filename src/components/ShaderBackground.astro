---
/**
 * ShaderBackground — Full-viewport WebGL canvas
 * Renders animated noise + rolling light behind all content.
 * Film grain is applied via a CSS overlay at native resolution
 * to stay crisp regardless of WebGL canvas downscaling.
 */
---

<div id="image-bg" aria-hidden="true" transition:persist="image-bg"></div>
<div id="noise-overlay" aria-hidden="true" transition:persist="noise-overlay"></div>

<style>
  #image-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    background-image: url('/bg.png');
    background-size: cover;
    background-position: center;
  }

  #noise-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    opacity: 0.45;
    mix-blend-mode: overlay;
    background-repeat: repeat;
    background-size: 128px 128px;
  }
</style>

<script>
  import { createShaderProgram, createFullscreenQuad, resizeCanvasToDisplaySize } from '../lib/webgl-utils';
  import { noiseDataUri } from '../lib/noise-texture';
  import vertSrc from '../shaders/background.vert?raw';
  import fragSrc from '../shaders/background.frag?raw';

  function initBackground() {
    if ((window as any).__SHADER_INIT_DONE__) return;
    (window as any).__SHADER_INIT_DONE__ = true;

    const canvas = document.getElementById('shader-bg') as HTMLCanvasElement;
    if (!canvas) return;

    // Apply noise overlay texture (base64-inlined, no HTTP request)
    const noiseEl = document.getElementById('noise-overlay') as HTMLDivElement;
    if (noiseEl) {
      noiseEl.style.backgroundImage = `url("${noiseDataUri}")`;
    }

    const gl = canvas.getContext('webgl2', { alpha: false, antialias: false, powerPreference: 'low-power' });
    if (!gl) {
      console.warn('[ShaderBackground] WebGL2 not supported');
      return;
    }

    const program = createShaderProgram(gl, vertSrc, fragSrc);
    if (!program) return;

    const quad = createFullscreenQuad(gl);
    if (!quad) return;

    const uTime = gl.getUniformLocation(program, 'uTime');
    const uResolution = gl.getUniformLocation(program, 'uResolution');

    // Heavy downscale — this is a blurry dark gradient, doesn't need resolution
    const DOWNSCALE_FACTOR = 4;
    const dpr = window.devicePixelRatio / DOWNSCALE_FACTOR;
    let startTime = performance.now();
    let animId: number;
    let lastFrameTime = 0;

    function handleResize() {
      resizeCanvasToDisplaySize(canvas, dpr);
      gl!.viewport(0, 0, canvas.width, canvas.height);
    }

    window.addEventListener('resize', handleResize);
    handleResize(); // Initial sizing

    function render(now: number) {
      // Cap to ~10fps (100ms between frames) — this gradient moves so slowly
      // that 10fps is perceptually identical to 60fps
      if (now - lastFrameTime < 100) {
        animId = requestAnimationFrame(render);
        return;
      }
      lastFrameTime = now;

      gl!.useProgram(program);
      gl!.uniform1f(uTime, (now - startTime) / 1000.0);
      gl!.uniform2f(uResolution, canvas.width, canvas.height);

      gl!.bindVertexArray(quad);
      gl!.drawArrays(gl!.TRIANGLES, 0, 6);

      animId = requestAnimationFrame(render);
    }

    animId = requestAnimationFrame(render);

    // No cleanup or re-init needed on view transitions!
    // Astro's transition:persist="shader-bg" keeps this exact DOM element 
    // and its WebGL context alive across page loads.
  }

  // Init once on initial page load
  // initBackground(); // WebGL background temporarily disabled
</script>
