---
/**
 * Nav — Fixed navigation across all pages.
 */
export interface Props {
  active?: "about" | "projects" | "editorials" | "connect";
  showBack?: boolean;
  backUrl?: string;
  backText?: string;
  hideLinks?: boolean;
}

const { active, showBack = false, backUrl = "/", backText, hideLinks = false } = Astro.props;
const isHome = Astro.url.pathname === '/';
---

<nav id="main-nav" class={`fixed-nav ${isHome ? 'is-home' : 'is-page'}`}>
  {
    showBack && (
      <a href={backUrl} class="nav-back" aria-label="Go back">
        <span class="nav-back-icon">&larr;</span>
        {backText && <span class="nav-back-text">{backText}</span>}
      </a>
    )
  }

  {!hideLinks && (
    <>
      <!-- Desktop Nav Links -->
      <div class="nav-links-desktop">
        <div class="nav-group">
          <a href="/projects" class="nav-link">Projects</a>
          <span class="nav-amp">&amp;</span>
          <a href="/editorials" class="nav-link">Editorials</a>
        </div>
        <div class="nav-group">
          <a href="/connect" class="nav-link nav-link-sm">Connect</a>
        </div>
      </div>

      <!-- Mobile Hamburger Button -->
      <button id="mobile-menu-btn" class="mobile-menu-btn" aria-label="Toggle Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>

      <!-- Mobile Menu -->
      <div id="mobile-menu" class="mobile-menu">
        <a href="/projects" class="nav-link">Projects</a>
        <a href="/editorials" class="nav-link">Editorials</a>
        <a href="/connect" class="nav-link">Connect</a>
      </div>
    </>
  )}
</nav>

<script>
  function initNav() {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    if (btn && menu) {
      const newBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener("click", () => {
        menu.classList.toggle("open");
      });
    }
  }

  initNav();
  document.addEventListener("astro:after-swap", initNav);
</script>
