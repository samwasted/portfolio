---
/**
 * Nav — Fixed navigation across all pages.
 */
export interface Props {
  active?: 'about' | 'projects' | 'editorials' | 'contact';
  showBack?: boolean;
}

const { active, showBack = false } = Astro.props;
---

<nav id="main-nav" class="fixed-nav">
  {showBack && (
    <a href="/" class="nav-back" aria-label="Go back">&larr;</a>
  )}
  <div class="nav-main">
    <a href="/projects" class="nav-link">Projects</a>
    <a href="/editorials" class="nav-link">Editorials</a>
  </div>
  <div class="nav-secondary">
    <a href="/contact" class="nav-link nav-link-sm">Contact</a>
    <a href="/about" class="nav-link nav-link-sm">About me</a>
  </div>
</nav>

<style>
  /* --- Nav — fixed position so it never jumps across pages --- */
  .fixed-nav {
    position: fixed;
    top: 6rem;
    right: 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.2rem;
    z-index: 100;
  }

  .nav-back {
    position: fixed;
    top: 2rem;
    left: 2.5rem;
    font-size: 1.5rem;
    color: var(--text-primary);
    text-decoration: none;
    z-index: 100;
    line-height: 1;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }

  .nav-back:hover {
    opacity: 1;
  }

  .nav-main,
  .nav-secondary {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.15rem 0;
    transition: color 0.2s ease;
  }

  .nav-link-sm {
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .nav-link:hover {
    color: var(--text-primary);
    opacity: 1;
  }

  /* --- Mobile --- */
  @media (max-width: 768px) {
    .fixed-nav {
      top: auto;
      bottom: 3rem;
      right: 50%;
      transform: translateX(50%);
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .nav-main,
    .nav-secondary {
      align-items: center;
    }
  }
</style>
