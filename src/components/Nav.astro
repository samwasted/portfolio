---
/**
 * Nav — Fixed navigation across all pages.
 */
export interface Props {
  active?: 'about' | 'projects' | 'editorials' | 'contact';
  showBack?: boolean;
}

const { active, showBack = false } = Astro.props;
---

<nav id="main-nav" class="fixed-nav">
  {showBack && (
    <a href="/" class="nav-back" aria-label="Go back">&larr;</a>
  )}
  <div class="nav-group">
    <a href="/about" class="nav-link nav-link-sm">About me</a>
  </div>
  <div class="nav-group">
    <a href="/projects" class="nav-link">Projects</a>
    <span class="nav-amp">&amp;</span>
    <a href="/editorials" class="nav-link">Editorials</a>
  </div>
  <div class="nav-group">
    <a href="/contact" class="nav-link nav-link-sm">Contact</a>
  </div>
</nav>

