---
/**
 * Projects — Cinematic IDE-like Sidebar list + detail panel.
 * Reads from src/data/projects.json config file.
 */
import fs from 'node:fs';
import path from 'node:path';

interface Project {
  name: string;
  category: string;
  summary: string;
  description: string;
  detail: string;
  techStack: string[];
  features: string[];
  github: string;
}

let projects: Project[] = [];
const projectsPath = path.resolve('src/data/projects.json');
if (fs.existsSync(projectsPath)) {
  projects = JSON.parse(fs.readFileSync(projectsPath, 'utf-8'));
}
---

<section id="projects" class="section projects-section">
  <div class="projects-layout">
    <!-- Sidebar / Explorer (35%) -->
    <aside class="projects-sidebar">
      <div class="sidebar-header">
        <h2 class="sidebar-title">Explorer</h2>
        <span class="sidebar-badge">{projects.length} PROJECTS</span>
      </div>
      
      <div class="projects-list" id="projects-list">
        {projects.map((project, i) => (
          <button
            class:list={['project-card', { active: i === 0 }]}
            data-index={i}
          >
            <div class="card-content">
              <span class="card-name">{project.name}</span>
              <span class="card-category">{project.category}</span>
            </div>
          </button>
        ))}
        {projects.length === 0 && (
          <p class="projects-empty">Projects coming soon...</p>
        )}
      </div>
    </aside>

    <!-- Detail Panel (65%) -->
    <article class="projects-detail" id="projects-detail">
      <button id="mobile-detail-close" class="mobile-close-btn" aria-label="Close details">
        <div class="drag-handle"></div>
      </button>
      
      {projects.length > 0 ? (
        <div class="detail-container" id="detail-container">
          <!-- Top: Title & Summary -->
          <header class="detail-header">
            <h1 class="detail-name" id="detail-name">{projects[0].name}</h1>
            <hr class="detail-divider" />
            <p class="detail-summary" id="detail-summary">{projects[0].summary}</p>
          </header>

          <!-- Center: Visual Area -->
          <div class="detail-visual">
            <div class="visual-pattern"></div>
          </div>

          <!-- Bottom: Description & Tech -->
          <div class="detail-body">
            <div class="detail-text-area">
              <p class="detail-description" id="detail-description">{projects[0].description}</p>
              
              <div class="detail-extended" id="detail-extended">
                <div class="features-list" id="detail-features">
                  <h4 class="section-heading">Key Features</h4>
                  <ul>
                    {projects[0].features.map(feature => (
                      <li>{feature}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>

            <div class="detail-meta">
              <div class="detail-tech" id="detail-tech">
                <h4 class="section-heading">Technologies</h4>
                <div class="tech-tags">
                  {projects[0].techStack.map(tech => (
                    <span class="tech-tag">{tech}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <!-- Footer: Links -->
          <footer class="detail-footer">
            <a class="github-link" id="detail-github" href={projects[0].github} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" class="github-icon">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              <span id="detail-github-text" class="github-text">{projects[0].github.replace('https://github.com/', '')}</span>
              <span class="external-arrow">↗</span>
            </a>
          </footer>
        </div>
      ) : (
        <div class="detail-container">
          <p class="projects-empty">Select a project to view details</p>
        </div>
      )}
    </article>
  </div>
</section>

<!-- Pass projects data to client-side JS -->
<script define:vars={{ projectsJson: JSON.stringify(projects) }}>
  window.__PROJECTS_DATA__ = JSON.parse(projectsJson);
</script>

<script>
  function initProjects() {
    const projects = (window as any).__PROJECTS_DATA__ || [];
    if (projects.length === 0) return;

    let lockedIndex = -1;
    let previewIndex = 0;
    const projectsList = document.querySelector('.projects-list');
    const cards = document.querySelectorAll('.project-card');
    const detailContainer = document.getElementById('detail-container');
    const layout = document.querySelector('.projects-layout');
    const closeBtn = document.getElementById('mobile-detail-close');
    
    // DOM Elements
    const detailName = document.getElementById('detail-name');
    const detailSummary = document.getElementById('detail-summary');
    const detailDesc = document.getElementById('detail-description');
    const detailFeatures = document.getElementById('detail-features');
    const detailTech = document.getElementById('detail-tech');
    const detailGithub = document.getElementById('detail-github') as HTMLAnchorElement;
    const detailGithubText = document.getElementById('detail-github-text');

    // Read More Logic
    // Removed read-more logic
    
    

    function selectProject(index: number, isHover = false) {
      const p = projects[index];
      if (!p) return;

      const isMobile = window.innerWidth <= 900;
      let wasClosed = false;

      if (layout && isMobile) {
        if (!layout.classList.contains('has-active-project')) {
          wasClosed = true;
          layout.classList.add('has-active-project');
        }
      }

      // Update active state on cards
      cards.forEach((card, i) => {
        if (isMobile) {
          card.classList.toggle('active', i === index);
        } else {
          card.classList.toggle('active', i === lockedIndex);
        }
      });

      const updateContent = () => {
        // Reset scroll position to top for the new project
        const detailPane = document.getElementById('projects-detail');
        if (detailPane) {
          detailPane.scrollTop = 0;
          detailPane.style.height = ''; // Always default back to CSS 60dvh
          detailPane.classList.remove('expanded-pane');
        }

        if (detailName) detailName.textContent = p.name;
        if (detailSummary) detailSummary.textContent = p.summary;
        if (detailDesc) detailDesc.textContent = p.description;
        
        if (detailFeatures) {
          detailFeatures.innerHTML = `
            <h4 class="section-heading">Key Features</h4>
            <ul>
              ${p.features.map((f: string) => `<li>${f}</li>`).join('')}
            </ul>
          `;
        }

        if (detailTech) {
          detailTech.innerHTML = `
            <h4 class="section-heading">Technologies</h4>
            <div class="tech-tags">
              ${p.techStack.map((t: string) => `<span class="tech-tag">${t}</span>`).join('')}
            </div>
          `;
        }

        if (detailGithub) detailGithub.href = p.github;
        if (detailGithubText) detailGithubText.textContent = p.github.replace('https://github.com/', '');

        // (Read More reset removed)
      };

      if (detailContainer) {
        if (isMobile && wasClosed) {
          // Opening from closed on mobile: update instantly so it slides up fully populated
          detailContainer.style.transition = 'none';
          updateContent();
          detailContainer.style.opacity = '1';
          detailContainer.style.transform = 'translateY(0)';
          void detailContainer.offsetWidth;
          detailContainer.style.transition = '';
        } else if (isHover && !isMobile) {
          // Fast preview on desktop hover: Instant update
          detailContainer.style.transition = 'none';
          updateContent();
          detailContainer.style.opacity = '1';
          detailContainer.style.transform = 'translateY(0)';
          void detailContainer.offsetWidth;
          detailContainer.style.transition = '';
        } else {
          // Desktop click-to-lock or mobile switch: manual CSS fade
          detailContainer.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
          detailContainer.style.opacity = '0';
          detailContainer.style.transform = 'translateY(5px)';
          setTimeout(() => {
            updateContent();
            detailContainer.style.opacity = '1';
            detailContainer.style.transform = 'translateY(0)';
          }, 200);
        }
      }

      if (isMobile) {
        const activeCard = cards[index] as HTMLElement;
        if (activeCard) {
          // Wait 150ms to ensure the layout has fully repainted the instant padding
          setTimeout(() => {
            const cardRect = activeCard.getBoundingClientRect();
            // The top 40dvh is visible. If the bottom of the card is below 35dvh, scroll it up!
            const bottomThreshold = window.innerHeight * 0.35; 
            const topThreshold = window.innerHeight * 0.10;
            
            if (cardRect.bottom > bottomThreshold || cardRect.top < topThreshold) {
              // Native robust scroll using CSS scroll-margin-top
              activeCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }, 150);
        }
      }
    }

    // Initial state setup
    if (window.innerWidth > 900) {
      if (cards.length > 0) {
        lockedIndex = -1;
        previewIndex = 0;
        selectProject(0, true); // Initial default render
      }
    } else {
      cards.forEach(c => c.classList.remove('active'));
      if (layout) layout.classList.remove('has-active-project');
    }

    if (closeBtn) {
      const newCloseBtn = closeBtn.cloneNode(true);
      closeBtn.parentNode?.replaceChild(newCloseBtn, closeBtn);

      // Advanced drag physics for resizing/closing
      let startY = 0;
      let currentY = 0;
      let startHeight = 0;
      let isDragging = false;
      const detailPane = document.getElementById('projects-detail');

      newCloseBtn.addEventListener('pointerdown', (e: PointerEvent) => {
        startY = e.clientY;
        currentY = startY; // Initialize currentY safely
        if (!detailPane) return;
        startHeight = detailPane.offsetHeight;
        isDragging = true;
        detailPane.classList.add('is-dragging');
        newCloseBtn.setPointerCapture(e.pointerId);
      });

      newCloseBtn.addEventListener('pointermove', (e: PointerEvent) => {
        if (!isDragging || !detailPane) return;
        e.preventDefault();
        currentY = e.clientY;
        const deltaY = currentY - startY; // positive = dragging down
        
        const newHeight = startHeight - deltaY;
        detailPane.style.height = `${newHeight}px`;
      });

      const handlePointerUp = (e: PointerEvent) => {
        if (!isDragging || !detailPane) return;
        isDragging = false;
        detailPane.classList.remove('is-dragging');
        newCloseBtn.releasePointerCapture(e.pointerId);
        
        const deltaY = currentY - startY;
        const finalHeight = startHeight - deltaY;
        
        detailPane.style.height = ''; // Let CSS take over
        
        const windowHeight = window.innerHeight;
        const vh60 = windowHeight * 0.6;
        const vh85 = windowHeight * 0.85;
        
        // If it was just a tap (deltaY is tiny), close the pane.
        if (Math.abs(deltaY) < 5) {
          if (layout) layout.classList.remove('has-active-project');
          cards.forEach(c => c.classList.remove('active'));
          detailPane.classList.remove('expanded-pane');
          return;
        }
        
        if (finalHeight < vh60 * 0.8) {
          // Dragged down significantly below 60% -> Close
          if (layout) layout.classList.remove('has-active-project');
          cards.forEach(c => c.classList.remove('active'));
          detailPane.classList.remove('expanded-pane');
        } else if (finalHeight > (vh60 + (vh85 - vh60) * 0.25)) {
          // Dragged up towards 85% -> Snap to 85%
          detailPane.classList.add('expanded-pane');
        } else {
          // Snap back to 60%
          detailPane.classList.remove('expanded-pane');
        }
      };

      newCloseBtn.addEventListener('pointerup', handlePointerUp);
      newCloseBtn.addEventListener('pointercancel', handlePointerUp);
    }

    cards.forEach((card) => {
      const idx = parseInt((card as HTMLElement).dataset.index || '0');

      card.addEventListener('click', () => {
        const isActive = card.classList.contains('active');
        
        if (window.innerWidth <= 900) {
          if (isActive && layout && layout.classList.contains('has-active-project')) {
            // Close the pane if clicking the active project again on mobile
            layout.classList.remove('has-active-project');
            cards.forEach(c => c.classList.remove('active'));
          } else {
            selectProject(idx);
          }
        } else {
          // Desktop behavior
          if (lockedIndex === idx) {
            lockedIndex = -1; // Release lock if clicking the locked project
            cards.forEach(c => c.classList.remove('active'));
          } else {
            lockedIndex = idx; // Lock the clicked project
            cards.forEach((c, i) => c.classList.toggle('active', i === lockedIndex));
            if (previewIndex !== idx) {
              previewIndex = idx;
              selectProject(idx);
            }
          }
        }
      });

      card.addEventListener('mouseenter', () => {
        if (window.innerWidth > 900) {
          if (lockedIndex !== -1) return; // If something is locked, hover does nothing
          if (previewIndex !== idx) {
            previewIndex = idx;
            selectProject(idx, true); // Preview the hovered project
          }
        }
      });
    });

    if (projectsList) {
      projectsList.addEventListener('mouseleave', () => {
        if (window.innerWidth > 900) {
          if (lockedIndex === -1 && previewIndex !== 0) {
            // If unlocked, reverting mouse leaves it to default (0)
            previewIndex = 0;
            selectProject(0, true);
          }
        }
      });
    }

    // Release lock by clicking empty space on the left side (sidebar)
    document.addEventListener('click', (e) => {
      if (window.innerWidth <= 900) return;
      const sidebar = document.querySelector('.projects-sidebar');
      if (sidebar && sidebar.contains(e.target as Node)) {
        const isCard = (e.target as Element).closest('.project-card');
        if (!isCard) {
          lockedIndex = -1;
          cards.forEach(c => c.classList.remove('active'));
          // Mouse is in sidebar empty space, not over a card, so revert to default
          if (previewIndex !== 0) {
             previewIndex = 0;
             selectProject(0, true);
          }
        }
      }
    });
  }

  initProjects();
  document.addEventListener('astro:after-swap', initProjects);
</script>

<style>
  .projects-section {
    min-height: 100vh;
    padding: 0;
    display: flex;
    align-items: center;
    background-color: transparent; /* Rely on body background/shader */
  }

  .projects-layout {
    display: grid;
    grid-template-columns: 35% 65%;
    width: 100%;
    height: 100vh;
    max-width: 100%;
  }

  /* ============================================
     LEFT COLUMN: EXPLORER
     ============================================ */
  .projects-sidebar {
    height: 100vh;
    border-right: 1px solid var(--border-strong);
    display: flex;
    flex-direction: column;
    padding: 6rem 2rem 2rem 4rem; /* Top padding clears Nav */
    background: linear-gradient(to right, rgba(10,10,10,0.8) 0%, rgba(10,10,10,0.4) 100%);
    backdrop-filter: blur(5px);
  }

  .sidebar-header {
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .sidebar-title {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .sidebar-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    background: var(--surface);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    overflow-y: auto;
    padding-right: 1rem;
    /* Hide scrollbar but keep functionality */
    scrollbar-width: none;
  }
  .projects-list::-webkit-scrollbar {
    display: none;
  }

  .project-card {
    display: flex;
    align-items: center;
    padding: 1.25rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    cursor: pointer;
    text-align: left;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .project-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 0%;
    width: 2px;
    background-color: var(--text-primary);
    transition: height 0.3s ease;
  }

  .project-card:hover {
    background: var(--surface-hover);
  }

  .project-card.active {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-strong);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .project-card.active::before {
    height: 60%;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .card-name {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 0.3s ease;
  }

  .project-card.active .card-name {
    color: var(--text-primary);
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
  }

  .card-category {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .projects-empty {
    color: var(--text-muted);
    font-size: 0.9rem;
    font-family: var(--font-mono);
  }

  /* ============================================
     RIGHT COLUMN: DETAIL PANEL
     ============================================ */
  .projects-detail {
    height: 100vh;
    padding: 6rem 4rem 2rem 4rem;
    overflow-y: auto;
    position: relative;
  }

  .detail-container {
    max-width: 800px;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .detail-header {
    margin-bottom: 2rem;
  }

  .detail-name {
    font-family: var(--font-serif);
    font-size: 3.5rem;
    color: var(--text-primary);
    line-height: 1.1;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .detail-divider {
    border: none;
    height: 1px;
    background: linear-gradient(90deg, var(--border-strong) 0%, transparent 100%);
    margin-bottom: 1rem;
  }

  .detail-summary {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    color: var(--text-secondary);
    font-weight: 300;
  }

  /* Cinematic Center Visual Area */
  .detail-visual {
    width: 100%;
    height: 250px;
    margin-bottom: 2rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    position: relative;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.4);
  }

  /* Subtle monochromatic abstract pattern */
  .visual-pattern {
    position: absolute;
    inset: -20%;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 30px 30px;
    background-position: center center;
    opacity: 0.6;
    transition: transform 0.5s ease-out;
  }

  /* Slight parallax on hover over the visual area */
  .detail-visual:hover .visual-pattern {
    transform: scale(1.05) translate(1%, 1%);
  }

  /* Overlay vignette for the cinematic feel */
  .detail-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 0%, rgba(0,0,0,0.8) 100%);
    pointer-events: none;
  }

  .detail-body {
    display: flex;
    gap: 3rem;
    flex: 1;
    margin-bottom: 2rem;
  }

  .detail-text-area {
    flex: 2;
  }

  .detail-meta {
    flex: 1;
  }

  .detail-description {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .detail-extended {
    margin-top: 1.5rem;
  }

  :global(.section-heading) {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    opacity: 0.9;
  }

  :global(.features-list ul) {
    list-style: none;
    padding: 0;
  }

  :global(.features-list li) {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  :global(.features-list li::before) {
    content: '→';
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  :global(.tech-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  :global(.tech-tag) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  :global(.tech-tag:hover) {
    background: var(--surface-hover);
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  /* Footer */
  .detail-footer {
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    transition: color 0.2s ease;
  }

  .github-link:hover {
    color: var(--text-primary);
  }

  .github-text {
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .github-link:hover .github-text {
    border-color: var(--text-primary);
  }

  .external-arrow {
    font-size: 1rem;
    opacity: 0.5;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .github-link:hover .external-arrow {
    transform: translate(2px, -2px);
    opacity: 1;
  }

  /* ============================================
     RESPONSIVE (MOBILE)
     ============================================ */
  @media (max-width: 900px) {
    .projects-layout {
      display: block;
      height: 100dvh;
      width: 100%;
      overflow: hidden;
      position: relative;
    }

    .projects-sidebar {
      height: 100dvh;
      border-right: none;
      padding: 5rem 1.5rem 2rem 1.5rem;
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .projects-layout.has-active-project .projects-sidebar {
      padding-bottom: 65dvh;
    }

    .projects-list {
      flex-direction: column;
      overflow-x: hidden;
      overflow-y: visible;
      padding-right: 0;
      padding-bottom: 0.5rem;
    }

    .project-card {
      min-width: unset;
      flex-shrink: 0;
      scroll-margin-top: 12dvh;
    }

    .project-card::before {
      top: 50%;
      left: 0;
      transform: translateY(-50%);
      width: 2px;
      height: 0%;
      transition: height 0.3s ease;
    }

