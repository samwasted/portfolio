---
/**
 * Projects — Cinematic IDE-like Sidebar list + detail panel.
 * Reads from src/data/projects.json config file.
 */
import projectsData from '../data/projects.json';

interface Project {
  name: string;
  category: string;
  summary: string;
  description: string;
  detail: string;
  techStack: string[];
  features: string[];
  github: string;
}

let projects: Project[] = projectsData as Project[];
---

<section id="projects" class="section projects-section">
  <div class="projects-layout" data-projects={JSON.stringify(projects)}>
    <!-- Sidebar / Explorer (35%) -->
    <aside class="projects-sidebar">
      
      <div class="projects-list" id="projects-list">
        {projects.map((project, i) => (
          <button
            class="project-card"
            data-index={i}
          >
            <div class="card-content">
              <span class="card-name">{project.name}</span>
              <span class="card-category">{project.category}</span>
            </div>
          </button>
        ))}
        {projects.length === 0 && (
          <p class="projects-empty">Projects coming soon...</p>
        )}
      </div>
    </aside>

    <!-- Detail Panel (65%) -->
    <article class="projects-detail" id="projects-detail">

      <button id="mobile-detail-close" class="mobile-close-btn" aria-label="Close details">
        <div class="drag-handle"></div>
      </button>
      
      <div class="detail-panes-wrapper">
        {projects.length > 0 ? projects.map((p, index) => (
          <div class={`detail-container ${index === 0 ? 'active-pane' : ''}`} data-pane-index={index}>
            <!-- Top: Title & Summary -->
            <header class="detail-header">
              <h1 class="detail-name">{p.name}</h1>
              <a class="github-link mobile-header-link" href={p.github} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" class="github-icon">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                </svg>
                <span class="github-text">{p.github.replace('https://github.com/', '')}</span>
                <span class="external-arrow">↗</span>
              </a>
              <hr class="detail-divider" />
              <p class="detail-summary">{p.summary}</p>
            </header>

            <!-- Center: Visual Area -->
            <div class="detail-visual">
              <div class="visual-pattern"></div>
            </div>

            <!-- Bottom: Description & Tech -->
            <div class="detail-body">
              <div class="detail-text-area">
                <p class="detail-description">{p.description}</p>
                
                <div class="detail-extended">
                  <div class="features-list">
                    <h4 class="section-heading">Key Features</h4>
                    <ul>
                      {p.features.map(feature => (
                        <li>{feature}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>

              <div class="detail-meta">
                <div class="detail-tech">
                  <h4 class="section-heading">Technologies</h4>
                  <div class="tech-tags">
                    {p.techStack.map(tech => (
                      <span class="tech-tag">{tech}</span>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <!-- Footer: Links -->
            <footer class="detail-footer">
              <a class="github-link" href={p.github} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" class="github-icon">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                </svg>
                <span class="github-text">{p.github.replace('https://github.com/', '')}</span>
                <span class="external-arrow">↗</span>
              </a>
            </footer>
          </div>
        )) : (
          <div class="detail-container active-pane">
            <p class="projects-empty">Select a project to view details</p>
          </div>
        )}
      </div>
    </article>
  </div>
</section>



<script>
  class ProjectController {
    projects: any[] = [];
    cards: HTMLElement[] = [];
    panes: HTMLElement[] = [];
    layout: HTMLElement | null = null;
    projectsList: HTMLElement | null = null;
    closeBtn: HTMLElement | null = null;
    lockedIndex: number = -1;
    previewIndex: number = 0;
    hoverTimeout: any = null;
    isAnimating: boolean = false;

    constructor() {
      this.layout = document.querySelector('.projects-layout') as HTMLElement | null;
      if (!this.layout) return;

      try {
        const rawData = this.layout.dataset.projects;
        this.projects = rawData ? JSON.parse(rawData) : [];
      } catch (e) {
        this.projects = [];
      }
      
      this.cards = Array.from(document.querySelectorAll('.project-card')) as HTMLElement[];
      this.panes = Array.from(document.querySelectorAll('.detail-container')) as HTMLElement[];
      this.layout = document.querySelector('.projects-layout') as HTMLElement | null;
      this.projectsList = document.querySelector('.projects-list') as HTMLElement | null;
      this.closeBtn = document.getElementById('mobile-detail-close');

      if (this.projects.length === 0) return;

      this.bindEvents();
      this.initDefaultState();
      this.initMobileDrag();
    }

    get isMobile() {
      return window.innerWidth <= 900;
    }

    initDefaultState() {
      if (!this.isMobile) {
        this.lockedIndex = -1;
        this.previewIndex = 0;
        this.updateActiveCards();
        this.updateActivePane();
      } else {
        this.cards.forEach(c => c.classList.remove('active'));
        if (this.layout) this.layout.classList.remove('has-active-project');
      }
    }

    updateActiveCards() {
      this.cards.forEach((card, i) => {
        if (this.isMobile) {
          card.classList.toggle('active', i === this.previewIndex);
        } else {
          card.classList.toggle('active', i === this.lockedIndex);
        }
      });
    }

    updateActivePane() {
      this.panes.forEach((pane, i) => {
        if (i === this.previewIndex) {
          pane.classList.add('active-pane');
        } else {
          pane.classList.remove('active-pane');
        }
      });
      
      // Reset scroll state on mobile wrapper
      const detailPane = document.getElementById('projects-detail');
      if (detailPane) {
        detailPane.scrollTop = 0;
        detailPane.style.height = ''; 
        detailPane.classList.remove('expanded-pane');
      }

    }

    transitionTo(index: number) {
      if (this.previewIndex === index) return;
      this.previewIndex = index;
      
      this.updateActiveCards();
      this.updateActivePane();
    }

    bindEvents() {
      this.cards.forEach((card) => {
        const idx = parseInt((card as HTMLElement).dataset.index || '0');

        card.addEventListener('click', () => {
          if (this.isMobile) {
            const isActive = card.classList.contains('active');
            const hasPane = this.layout?.classList.contains('has-active-project');

            if (isActive && hasPane) {
              // Close
              this.layout?.classList.remove('has-active-project');
              this.cards.forEach(c => c.classList.remove('active'));
            } else {
              const wasOpen = hasPane;
              
              if (!wasOpen) {
                // If opening for the first time, wait for layout to settle before scrolling
                this.transitionTo(idx);
                requestAnimationFrame(() => {
                  requestAnimationFrame(() => {
                    this.layout?.classList.add('has-active-project');
                    this.updateActiveCards();
                    const activeCard = this.cards[idx] as HTMLElement;
                    if (activeCard) {
                      activeCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                  });
                });
              } else {
                // If already open, just instantly switch content and scroll without dropping the pane
                this.transitionTo(idx);
                const activeCard = this.cards[idx] as HTMLElement;
                if (activeCard) {
                  activeCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
              }
            }
          } else {
            // Desktop click-to-lock
            if (this.lockedIndex === idx) {
              this.lockedIndex = -1;
              this.updateActiveCards();
            } else {
              this.lockedIndex = idx;
              this.updateActiveCards();
              this.transitionTo(idx);
            }
          }
        });

        card.addEventListener('mouseenter', () => {
          if (!this.isMobile) {
            if (this.lockedIndex !== -1) return; // Locked ignores hover
            
            // Debounce the hover
            clearTimeout(this.hoverTimeout);
            this.hoverTimeout = setTimeout(() => {
              this.transitionTo(idx);
            }, 50);
          }
        });
      });

      if (this.projectsList) {
        this.projectsList.addEventListener('mouseleave', () => {
          if (!this.isMobile) {
            clearTimeout(this.hoverTimeout);
            // Deliberately DO NOT transitionTo(0).
            // This leaves the UI parked on the last hovered project.
          }
        });
      }

      document.addEventListener('click', (e) => {
        if (this.isMobile) return;
        const sidebar = document.querySelector('.projects-sidebar');
        if (sidebar && sidebar.contains(e.target as Node)) {
          const isCard = (e.target as Element).closest('.project-card');
          if (!isCard) {
            this.lockedIndex = -1;
            this.updateActiveCards();
            if (this.previewIndex !== 0) {
               this.transitionTo(0);
            }
          }
        }
      });
    }

    initMobileDrag() {
      const detailPane = document.getElementById('projects-detail');
      const closeBtn = document.getElementById('mobile-detail-close');
      if (!detailPane || !closeBtn) return;

      // --- 1. Content Pull-to-Close (Instagram Style) ---
      let touchStartY = 0;
      let isTouchOnPane = false;

      detailPane.addEventListener('touchstart', (e: TouchEvent) => {
        touchStartY = e.touches[0].clientY;
        isTouchOnPane = true;
      }, { passive: true });

      detailPane.addEventListener('touchmove', (e: TouchEvent) => {
        if (!isTouchOnPane) return;
        const deltaY = e.touches[0].clientY - touchStartY;
        const atTop = detailPane.scrollTop === 0;

        // Require a firm 60px pull down to close, so it's not overly sensitive
        if (atTop && deltaY > 60) {
          e.preventDefault();
          this.layout?.classList.remove('has-active-project');
          this.cards.forEach(c => c.classList.remove('active'));
          detailPane.classList.remove('expanded-pane');
          isTouchOnPane = false;
        }
      }, { passive: false });

      detailPane.addEventListener('touchend', () => {
        isTouchOnPane = false;
      });

      // --- 2. Handle Drag-to-Resize (Restoring 85% Stretch) ---
      const newCloseBtn = closeBtn.cloneNode(true) as HTMLElement;
      closeBtn.parentNode?.replaceChild(newCloseBtn, closeBtn);

      let dragStartY = 0;
      let dragCurrentY = 0;
      let startHeight = 0;
      let isDragging = false;

      newCloseBtn.addEventListener('pointerdown', (e: PointerEvent) => {
        dragStartY = e.clientY;
        dragCurrentY = dragStartY;
        startHeight = detailPane.offsetHeight;
        isDragging = true;
        detailPane.classList.add('is-dragging');
        newCloseBtn.setPointerCapture(e.pointerId);
      });

      newCloseBtn.addEventListener('pointermove', (e: PointerEvent) => {
        if (!isDragging) return;
        e.preventDefault();
        dragCurrentY = e.clientY;
        const deltaY = dragCurrentY - dragStartY;
        const newHeight = startHeight - deltaY;
        detailPane.style.height = `${newHeight}px`;
      });

      const handlePointerUp = (e: PointerEvent) => {
        if (!isDragging) return;
        isDragging = false;
        detailPane.classList.remove('is-dragging');
        newCloseBtn.releasePointerCapture(e.pointerId);
        
        const deltaY = dragCurrentY - dragStartY;
        const finalHeight = startHeight - deltaY;
        detailPane.style.height = ''; 
        
        const windowHeight = window.innerHeight;
        const vh60 = windowHeight * 0.6;
        const vh85 = windowHeight * 0.85;
        
        // Tap or tiny drag to close fallback
        if (Math.abs(deltaY) < 5) {
          this.layout?.classList.remove('has-active-project');
          this.cards.forEach(c => c.classList.remove('active'));
          detailPane.classList.remove('expanded-pane');
          return;
        }
        
        // Snap logic: Close if dragged down far enough, expand to 85% if dragged up
        if (finalHeight < vh60 * 0.8) {
          this.layout?.classList.remove('has-active-project');
          this.cards.forEach(c => c.classList.remove('active'));
          detailPane.classList.remove('expanded-pane');
        } else if (finalHeight > (vh60 + (vh85 - vh60) * 0.25)) {
          detailPane.classList.add('expanded-pane');
        } else {
          detailPane.classList.remove('expanded-pane');
        }
      };

      newCloseBtn.addEventListener('pointerup', handlePointerUp);
      newCloseBtn.addEventListener('pointercancel', handlePointerUp);
    }
  }

  // Use Astro's official page-load hook to re-initialize on every navigation
  document.addEventListener('astro:page-load', () => {
    // Only init if we are actually on a page that contains projects
    if (document.querySelector('.projects-layout')) {
      new ProjectController();
    }
  });
</script>

<style>
  .detail-panes-wrapper {
    display: grid;
    grid-template-areas: "stack";
    position: relative;
    z-index: 1;
  }

  .projects-section {
    min-height: 100vh;
    padding: 0;
    display: flex;
    align-items: center;
    background-color: transparent; /* Rely on body background/shader */
  }

  .projects-layout {
    display: grid;
    grid-template-columns: 35% 65%;
    width: 100%;
    height: 100vh;
    max-width: 100%;
  }

  /* ============================================
     LEFT COLUMN: EXPLORER
     ============================================ */
  .projects-sidebar {
    height: 100vh;
    border-right: 1px solid var(--border-strong);
    display: flex;
    flex-direction: column;
    padding: 6rem 4rem 2rem 4rem; /* Top padding clears Nav */
    background: linear-gradient(to right, rgba(10,10,10,0.8) 0%, rgba(10,10,10,0.4) 100%);
    backdrop-filter: blur(5px);
    position: relative;
  }

  /* Desktop white line separator for Explorer header */
  .projects-sidebar::before {
    content: '';
    position: absolute;
    top: 4.5rem;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.15);
    z-index: 10;
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    overflow-y: auto;
    /* Hide scrollbar but keep functionality */
    scrollbar-width: none;
  }
  .projects-list::-webkit-scrollbar {
    display: none;
  }

  .project-card {
    display: flex;
    align-items: center;
    padding: 1.25rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    cursor: pointer;
    text-align: left;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .project-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 0%;
    width: 2px;
    background-color: var(--text-primary);
    transition: height 0.3s ease;
  }

  @media (hover: hover) {
    .project-card:hover {
      background: var(--surface-hover);
    }
  }

  .project-card.active {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-strong);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .project-card.active::before {
    height: 60%;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .card-name {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 0.3s ease;
  }

  .project-card.active .card-name {
    color: var(--text-primary);
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
  }

  .card-category {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .projects-empty {
    color: var(--text-muted);
    font-size: 0.9rem;
    font-family: var(--font-mono);
  }

  /* ============================================
     RIGHT COLUMN: DETAIL PANEL
     ============================================ */
  .projects-detail {
    height: 100vh;
    padding: 6rem 4rem 2rem 4rem;
    overflow-y: auto;
    position: relative;
    z-index: 1;
    background-color: transparent;
  }

  .detail-container {
    grid-area: stack;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    
    opacity: 0;
    pointer-events: none;
    transform: translateY(4px);
    filter: blur(2px);
    transition: opacity 0.25s ease, transform 0.25s ease, filter 0.25s ease;
  }

  .detail-container.active-pane {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    filter: blur(0);
  }

  .detail-header {
    margin-bottom: 2rem;
  }

  .detail-name {
    font-family: var(--font-serif);
    font-size: 3.5rem;
    color: var(--text-primary);
    line-height: 1.1;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .detail-divider {
    border: none;
    height: 1px;
    background: linear-gradient(90deg, var(--border-strong) 0%, transparent 100%);
    margin-bottom: 1rem;
  }

  .detail-summary {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    color: var(--text-secondary);
    font-weight: 300;
  }

  /* Cinematic Center Visual Area */
  .detail-visual {
    width: 100%;
    height: 250px;
    margin-bottom: 2rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    position: relative;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.4);
  }

  /* Subtle monochromatic abstract pattern */
  .visual-pattern {
    position: absolute;
    inset: -20%;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 30px 30px;
    background-position: center center;
    opacity: 0.6;
    transition: transform 0.5s ease-out;
  }

  /* Slight parallax on hover over the visual area */
  .detail-visual:hover .visual-pattern {
    transform: scale(1.05) translate(1%, 1%);
  }

  /* Overlay vignette for the cinematic feel */
  .detail-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 0%, rgba(0,0,0,0.8) 100%);
    pointer-events: none;
  }

  .detail-body {
    display: flex;
    gap: 3rem;
    flex: 1;
    margin-bottom: 2rem;
  }

  .detail-text-area {
    flex: 2;
  }

  .detail-footer {
    display: block;
  }

  .mobile-header-link {
    display: none !important;
  }

  .detail-meta {
    flex: 1;
  }

  .detail-description {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .detail-extended {
    margin-top: 1.5rem;
  }

  :global(.section-heading) {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    opacity: 0.9;
  }

  :global(.features-list ul) {
    list-style: none;
    padding: 0;
  }

  :global(.features-list li) {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  :global(.features-list li::before) {
    content: '→';
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  :global(.tech-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  :global(.tech-tag) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  :global(.tech-tag:hover) {
    background: var(--surface-hover);
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  /* Footer */
  .detail-footer {
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    transition: color 0.2s ease;
  }

  .github-link:hover {
    color: var(--text-primary);
  }

  .github-text {
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .github-link:hover .github-text {
    border-color: var(--text-primary);
  }

  .external-arrow {
    font-size: 1rem;
    opacity: 0.5;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .github-link:hover .external-arrow {
    transform: translate(2px, -2px);
    opacity: 1;
  }

  /* ============================================
     RESPONSIVE (MOBILE)
     ============================================ */
  @media (max-width: 900px) and (orientation: portrait) {
    .projects-layout {
      display: block;
      height: 100dvh;
      width: 100%;
      overflow: hidden;
      position: relative;
    }

    .projects-sidebar {
      height: 100dvh;
