---
/**
 * Projects — Sidebar list + detail panel.
 * Reads from src/data/projects.json config file.
 */
import fs from 'node:fs';
import path from 'node:path';

interface Project {
  name: string;
  category: string;
  description: string;
  detail: string;
  techStack: string[];
  github: string;
  image?: string;
}

let projects: Project[] = [];
const projectsPath = path.resolve('src/data/projects.json');
if (fs.existsSync(projectsPath)) {
  projects = JSON.parse(fs.readFileSync(projectsPath, 'utf-8'));
}
---

<section id="projects" class="section projects-section">
  <div class="projects-layout">
    <!-- Sidebar -->
    <div class="projects-sidebar">
      <button class="scroll-arrow up" id="projects-up" aria-label="Scroll up">&#8963;</button>
      <div class="projects-list" id="projects-list">
        {projects.map((project, i) => (
          <button
            class:list={['project-item', { active: i === 0 }]}
            data-index={i}
          >
            <span class="project-item-name">{project.name}</span>
            <span class="project-item-category">{project.category}</span>
          </button>
        ))}
        {projects.length === 0 && (
          <p class="projects-empty">Projects coming soon...</p>
        )}
      </div>
      <button class="scroll-arrow down" id="projects-down" aria-label="Scroll down">&#8964;</button>
    </div>

    <!-- Detail Panel -->
    <div class="projects-detail" id="projects-detail">
      {projects.length > 0 ? (
        <div class="detail-content" id="detail-content">
          <h3 class="detail-name" id="detail-name">{projects[0].name}</h3>
          <p class="detail-description" id="detail-description">{projects[0].description}</p>
          <div class="detail-text" id="detail-text">
            <p>{projects[0].detail}</p>
          </div>
          <div class="detail-tech" id="detail-tech">
            <h4>Tech stack</h4>
            <div class="tech-tags">
              {projects[0].techStack.map(tech => (
                <span class="tech-tag">•{tech}</span>
              ))}
            </div>
          </div>
          <a class="detail-github" id="detail-github" href={projects[0].github} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span id="detail-github-text">{projects[0].github.replace('https://', '')}</span>
            <span class="external-arrow">↗</span>
          </a>
        </div>
      ) : (
        <div class="detail-content">
          <p class="projects-empty">Select a project to view details</p>
        </div>
      )}
    </div>
  </div>
</section>

<!-- Pass projects data to client-side JS -->
<script define:vars={{ projectsJson: JSON.stringify(projects) }}>
  window.__PROJECTS_DATA__ = JSON.parse(projectsJson);
</script>

<script>
  function initProjects() {
    const projects = (window as any).__PROJECTS_DATA__ || [];
    if (projects.length === 0) return;

    const items = document.querySelectorAll('.project-item');
    const detailName = document.getElementById('detail-name');
    const detailDesc = document.getElementById('detail-description');
    const detailText = document.getElementById('detail-text');
    const detailTech = document.getElementById('detail-tech');
    const detailGithub = document.getElementById('detail-github') as HTMLAnchorElement;
    const detailGithubText = document.getElementById('detail-github-text');

    function selectProject(index: number) {
      const p = projects[index];
      if (!p) return;

      items.forEach((item, i) => {
        item.classList.toggle('active', i === index);
      });

      if (detailName) detailName.textContent = p.name;
      if (detailDesc) detailDesc.textContent = p.description;
      if (detailText) detailText.innerHTML = `<p>${p.detail}</p>`;
      if (detailTech) {
        detailTech.innerHTML = `
          <h4>Tech stack</h4>
          <div class="tech-tags">
            ${p.techStack.map((t: string) => `<span class="tech-tag">•${t}</span>`).join('')}
          </div>
        `;
      }
      if (detailGithub) detailGithub.href = p.github;
      if (detailGithubText) detailGithubText.textContent = p.github.replace('https://', '');
    }

    items.forEach((item) => {
      item.addEventListener('click', () => {
        const idx = parseInt((item as HTMLElement).dataset.index || '0');
        selectProject(idx);
      });
    });

    // Scroll arrows
    const list = document.getElementById('projects-list');
    const upBtn = document.getElementById('projects-up');
    const downBtn = document.getElementById('projects-down');

    upBtn?.addEventListener('click', () => {
      list?.scrollBy({ top: -80, behavior: 'smooth' });
    });
    downBtn?.addEventListener('click', () => {
      list?.scrollBy({ top: 80, behavior: 'smooth' });
    });
  }

  initProjects();
  document.addEventListener('astro:after-swap', initProjects);
</script>

<style>
  .projects-section {
    min-height: 100vh;
    padding: 4rem var(--page-padding);
    display: flex;
    align-items: center;
  }

  .projects-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    width: 100%;
    max-width: var(--page-max-width);
    margin: 0 auto;
    min-height: 60vh;
  }

  /* Sidebar */
  .projects-sidebar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .scroll-arrow {
    background: none;
    border: none;
    color: var(--text-secondary);
    font-size: 1.5rem;
    cursor: pointer;
    padding: 0.25rem;
    line-height: 1;
  }

  .scroll-arrow:hover {
    color: var(--text-primary);
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    width: 100%;
    max-height: 400px;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .projects-list::-webkit-scrollbar {
    display: none;
  }

  .project-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0.75rem 1rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    cursor: pointer;
    text-align: left;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    width: 100%;
  }

  .project-item:hover {
    background: var(--surface);
    border-color: var(--border);
  }

  .project-item.active {
    background: var(--surface-hover);
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  .project-item-name {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .project-item-category {
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-top: 0.15rem;
  }

  .projects-empty {
    color: var(--text-muted);
    font-size: 0.9rem;
    padding: 1rem;
  }

  /* Detail panel */
  .projects-detail {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem 0;
  }

  .detail-content {
    max-width: 550px;
  }

  .detail-name {
    font-size: var(--text-2xl);
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: var(--space-md);
  }

  .detail-description {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
    line-height: 1.6;
  }

  .detail-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-lg);
  }

  .detail-tech {
    margin-bottom: var(--space-lg);
  }

  .detail-tech h4 {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-tag {
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-family: var(--font-sans);
  }

  .detail-github {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    padding: 0.75rem 0;
    border-top: 1px solid var(--border);
    text-decoration: none;
  }

  .detail-github svg {
    flex-shrink: 0;
  }

  .detail-github:hover {
    color: var(--text-primary);
    opacity: 1;
  }

  .external-arrow {
    font-size: 0.9rem;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .projects-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .projects-sidebar {
      max-height: 250px;
    }
  }
</style>
