---
/**
 * AboutShaderOverlay — Transparent WebGL canvas overlay
 * Renders the Mt Fuji watercolor shader over the existing background.
 * 
 * Performance strategy:
 *  1. Downscale canvas to 1/3 native resolution (matches main background)
 *  2. Cap framerate to 30fps during animation
 *  3. Freeze completely once the reveal animation finishes (~8s)
 */
---

<canvas id="about-shader-overlay" aria-hidden="true"></canvas>

<style>
  #about-shader-overlay {
    position: fixed;
    top: 1rem;
    left: 1rem;
    width: calc(100% - 2rem);
    height: calc(100% - 2rem);
    z-index: 10;
    pointer-events: none;
  }
</style>

<script>
  import { createShaderProgram, createFullscreenQuad, resizeCanvasToDisplaySize } from '../lib/webgl-utils';
  import vertSrc from '../shaders/background.vert?raw';
  import fragSrc from '../shaders/about.frag?raw';

  function initAboutShader() {
    const canvas = document.getElementById('about-shader-overlay') as HTMLCanvasElement;
    if (!canvas) return;

    // Prevent double-init
    if ((canvas as any).__about_init) return;
    (canvas as any).__about_init = true;

    const gl = canvas.getContext('webgl2', { alpha: true, antialias: false, premultipliedAlpha: false });
    if (!gl) return;

    const program = createShaderProgram(gl, vertSrc, fragSrc);
    if (!program) return;

    const quad = createFullscreenQuad(gl);
    if (!quad) return;

    const uTime = gl.getUniformLocation(program, 'uTime');
    const uResolution = gl.getUniformLocation(program, 'uResolution');

    gl.enable(gl.BLEND);
    gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);

    // Downscale to 1/3 native resolution — matches main background shader
    const DOWNSCALE_FACTOR = 3;
    const dpr = window.devicePixelRatio / DOWNSCALE_FACTOR;
    let startTime = performance.now();
    let animId: number;
    let lastFrameTime = 0;
    let frozen = false;

    // Animation completes at t_flowers end: t*0.8 needs to reach ~8.5s => t ~10.6s
    // At that point swayStrength is also 0. So after ~11s, freeze forever.
    const FREEZE_AFTER_MS = 11000;

    function handleResize() {
      resizeCanvasToDisplaySize(canvas, dpr);
      gl!.viewport(0, 0, canvas.width, canvas.height);
      // If frozen and resized, re-render one frame at the new size
      if (frozen) {
        renderFrame((performance.now() - startTime) / 1000.0);
      }
    }

    window.addEventListener('resize', handleResize);
    handleResize();

    function renderFrame(time: number) {
      gl!.clearColor(0, 0, 0, 0);
      gl!.clear(gl!.COLOR_BUFFER_BIT);
      gl!.useProgram(program);
      gl!.uniform1f(uTime, time);
      gl!.uniform2f(uResolution, canvas.width, canvas.height);
      gl!.bindVertexArray(quad);
      gl!.drawArrays(gl!.TRIANGLES, 0, 6);
    }

    function render(now: number) {
      // If canvas removed from DOM (navigated away), stop entirely
      if (!document.body.contains(canvas)) {
        window.removeEventListener('resize', handleResize);
        return;
      }

      const elapsed = now - startTime;

      // Once the reveal animation is done, render one final frame and stop
      if (elapsed > FREEZE_AFTER_MS && !frozen) {
        frozen = true;
        renderFrame(elapsed / 1000.0);
        return; // Stop the loop — 0% GPU from here
      }

      if (frozen) return;

      // Cap to ~10fps (100ms between frames)
      if (now - lastFrameTime < 100) {
        animId = requestAnimationFrame(render);
        return;
      }
      lastFrameTime = now;

      renderFrame(elapsed / 1000.0);
      animId = requestAnimationFrame(render);
    }

    animId = requestAnimationFrame(render);
  }

  // Init directly when component mounts
  initAboutShader();
  document.addEventListener('astro:after-swap', () => {
    const canvas = document.getElementById('about-shader-overlay') as HTMLCanvasElement;
    if (canvas && !(canvas as any).__about_init) {
      initAboutShader();
    }
  });
</script>
