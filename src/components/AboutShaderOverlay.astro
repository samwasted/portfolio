---
/**
 * AboutShaderOverlay — Transparent WebGL canvas overlay
 * Renders the about shader (flipped, half size, configurable position).
 * Renders exactly once (final state) for performance.
 */
export interface Props {
  position?: 'bottom-right' | 'top-right';
}

const { position = 'bottom-right' } = Astro.props;
---

<canvas id="about-shader-overlay" class={`pos-${position}`} aria-hidden="true"></canvas>

<style>
  #about-shader-overlay {
    position: fixed;
    width: 50vw;
    height: 50vh;
    z-index: 0; /* Placed behind text */
    pointer-events: none;
  }

  .pos-bottom-right {
    bottom: 0;
    right: 0;
    transform: scaleX(-1);
  }

  .pos-top-right {
    top: 0;
    right: 0;
    transform: scale(-1, -1); /* Flip vertically to anchor to top */
  }

  @media (max-width: 768px) {
    #about-shader-overlay {
      display: none;
    }
  }
</style>

<script>
  import { createShaderProgram, createFullscreenQuad, resizeCanvasToDisplaySize } from '../lib/webgl-utils';
  import vertSrc from '../shaders/background.vert?raw';
  import fragSrc from '../shaders/about.frag?raw';

  function initAboutShader() {
    // Paranoia check: absolutely do not load WebGL on mobile screens
    if (window.innerWidth <= 768) return;

    const canvas = document.getElementById('about-shader-overlay') as HTMLCanvasElement;
    if (!canvas) return;
    
    // Don't run WebGL on mobile since it's hidden
    if (window.getComputedStyle(canvas).display === 'none') return;

    // Prevent double-init
    if ((canvas as any).__about_init) return;
    (canvas as any).__about_init = true;

    const gl = canvas.getContext('webgl2', { alpha: true, antialias: false, premultipliedAlpha: false });
    if (!gl) return;

    const program = createShaderProgram(gl, vertSrc, fragSrc);
    if (!program) return;

    const quad = createFullscreenQuad(gl);
    if (!quad) return;

    const uTime = gl.getUniformLocation(program, 'uTime');
    const uResolution = gl.getUniformLocation(program, 'uResolution');

    gl.enable(gl.BLEND);
    gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);

    // Downscale to save memory
    const DOWNSCALE_FACTOR = 2;
    const dpr = window.devicePixelRatio / DOWNSCALE_FACTOR;

    let startTime = performance.now();
    let animId: number;
    let lastFrameTime = 0;
    let frozen = false;

    // Animation completes around 6.5s. We freeze after 7s to be safe.
    const FREEZE_AFTER_MS = 7000;

    let resizeTimeout: number | null = null;
    function handleResize() {
      if (resizeTimeout !== null) clearTimeout(resizeTimeout);
      resizeTimeout = window.setTimeout(() => {
        resizeCanvasToDisplaySize(canvas, dpr);
        gl!.viewport(0, 0, canvas.width, canvas.height);
        
        if (frozen) {
          // If already frozen, render the final frame state
          renderFrame((performance.now() - startTime) / 1000.0);
        }
      }, 100);
    }

    window.addEventListener('resize', handleResize);
    handleResize(); // Initial sizing

    function renderFrame(time: number) {
      gl!.clearColor(0, 0, 0, 0);
      gl!.clear(gl!.COLOR_BUFFER_BIT);
      gl!.useProgram(program);
      gl!.uniform1f(uTime, time);
      gl!.uniform2f(uResolution, canvas.width, canvas.height);
      gl!.bindVertexArray(quad);
      gl!.drawArrays(gl!.TRIANGLES, 0, 6);
    }

    let accumulator = 0;
    const TIME_STEP = 1000 / 30; // ~33.33ms for 30fps

    function render(now: number) {
      // Stop completely if navigated away
      if (!document.body.contains(canvas)) {
        window.removeEventListener('resize', handleResize);
        return; 
      }

      if (lastFrameTime === 0) lastFrameTime = now;
      const deltaTime = now - lastFrameTime;
      lastFrameTime = now;
      accumulator += deltaTime;

      const elapsed = now - startTime;

      // Freeze after animation completes
      if (elapsed > FREEZE_AFTER_MS) {
        if (!frozen) {
          frozen = true;
          renderFrame(elapsed / 1000.0);
        }
        return; // Kill the loop
      }

      // Draw at 30fps
      if (accumulator >= TIME_STEP) {
        accumulator = accumulator % TIME_STEP;
        renderFrame(elapsed / 1000.0);
      }

      animId = requestAnimationFrame(render);
    }

    animId = requestAnimationFrame(render);
  }

  // Init directly when component mounts
  initAboutShader();
  document.addEventListener('astro:after-swap', () => {
    const canvas = document.getElementById('about-shader-overlay') as HTMLCanvasElement;
    if (canvas && !(canvas as any).__about_init) {
      initAboutShader();
    }
  });
</script>
