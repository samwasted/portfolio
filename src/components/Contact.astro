<style>
  .contact-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .contact-content {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .contact-link:hover {
    color: var(--text-primary);
    opacity: 1;
  }

  .contact-icon {
    flex-shrink: 0;
    opacity: 0.8;
  }

  @media (max-width: 768px) {
    .contact-link {
      font-size: 0.8rem;
    }
  }
</style>
