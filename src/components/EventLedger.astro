---
/**
 * EventLedger — system log style timeline with a brush stroke spine.
 * Entries come from src/data/ledger.ts unless passed in; the stroke is
 * regenerated from each entry's level, so adding or removing entries
 * keeps the design intact.
 */
import { ledger, type LedgerEntry, type LedgerLevel } from "../data/ledger";
import { brushSegments } from "../lib/brush-stroke";

export interface Props {
  entries?: LedgerEntry[];
}

const { entries = ledger } = Astro.props;

const sorted = [...entries].sort((a, b) => a.date.localeCompare(b.date));
const strokes = brushSegments(sorted.map((e) => e.level));

// Class strings are written out in full so Tailwind can see them
const TAG_CLASS: Record<LedgerLevel, string> = {
  standard: "text-[#D4C594]/60",
  medium: "text-[#FFF3C7]/80",
  highlight: "text-[#FFF3C7] drop-shadow-[0_0_8px_rgba(255,255,255,0.8)]",
};

const TEXT_CLASS: Record<LedgerLevel, string> = {
  standard: "text-white/40 group-hover:text-white/70 transition-colors",
  medium: "text-white/80 group-hover:text-white transition-colors",
  highlight: "text-white font-medium drop-shadow-[0_0_8px_rgba(255,255,255,0.4)]",
};
---

<div class="font-mono text-base flex flex-col text-white/60 relative" data-brush-ledger>
  <!-- Rough edge for the brush stroke -->
  <svg width="0" height="0" aria-hidden="true" class="absolute">
    <filter id="brush-edge" x="-50%" y="0" width="200%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.6 0.04" numOctaves="2" seed="3" result="n" />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="1.3" />
    </filter>
  </svg>

  {sorted.map((entry, i) => (
    <div class="flex gap-4 group items-start relative z-10">
      <div class={`${TAG_CLASS[entry.level]} whitespace-nowrap w-[155px] flex-shrink-0 text-left md:text-right transition-opacity`}>
        [{entry.tag}] {entry.date}
      </div>
      <span class="ledger-stroke" aria-hidden="true">
        <svg viewBox="0 0 10 100" preserveAspectRatio="none"><path d={strokes[i]} /></svg>
      </span>
      <div class={`${TEXT_CLASS[entry.level]} leading-relaxed flex-1 pb-5`}>
        {entry.text}
      </div>
    </div>
  ))}
</div>

<script>
  // Draw the stroke top to bottom every time the ledger scrolls into view,
  // and reset it once it has fully left, so each visit replays the reveal.
  // Timing is measured per row so the brush moves at one speed through every segment.
  const MIN_SPEED = 0.45; // px per ms
  const MAX_TOTAL = 2200; // ms, so long ledgers on mobile don't crawl

  function draw(ledger: HTMLElement) {
    const strokes = Array.from(ledger.querySelectorAll<HTMLElement>(".ledger-stroke"));
    const total = strokes.reduce((sum, s) => sum + s.offsetHeight, 0);
    const speed = Math.max(MIN_SPEED, total / MAX_TOTAL);
    let offset = 0;
    for (const s of strokes) {
      s.style.setProperty("--draw-delay", `${offset / speed}ms`);
      s.style.setProperty("--draw-duration", `${s.offsetHeight / speed}ms`);
      offset += s.offsetHeight;
    }
    ledger.classList.add("brush-draw");
  }

  function initBrushLedgers() {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.querySelectorAll<HTMLElement>("[data-brush-ledger]:not([data-brush-init])").forEach((ledger) => {
      ledger.dataset.brushInit = "";
      if (reduceMotion || !("IntersectionObserver" in window)) return;

      // Hidden only once JS is running, so the stroke still shows without it
      ledger.classList.add("brush-pending");
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.intersectionRatio >= 0.25 && !ledger.classList.contains("brush-draw")) {
              draw(ledger);
            } else if (!e.isIntersecting) {
              ledger.classList.remove("brush-draw");
            }
          }
        },
        { threshold: [0, 0.25] },
      );
      io.observe(ledger);
    });
  }

  initBrushLedgers();
  document.addEventListener("astro:page-load", initBrushLedgers);
</script>

<style>
  /* The cell stretches to the row; the SVG fills it absolutely so it never sets the row height */
  .ledger-stroke {
    position: relative;
    align-self: stretch;
    flex-shrink: 0;
    width: 14px;
  }

  .ledger-stroke svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: #fff3c7;
    filter: url(#brush-edge) drop-shadow(0 0 6px rgba(255, 243, 199, 0.35));
  }

  /* Wet-edge reveal: a mask twice the row's height slides up, its soft
     boundary acting as the bleeding front of the ink */
  .brush-pending .ledger-stroke svg {
    -webkit-mask-image: linear-gradient(to bottom, #000 0 48%, transparent 54%);
    mask-image: linear-gradient(to bottom, #000 0 48%, transparent 54%);
    -webkit-mask-size: 100% 220%;
    mask-size: 100% 220%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: 0 100%;
    mask-position: 0 100%;
  }

  .brush-draw .ledger-stroke svg {
    animation: brush-draw var(--draw-duration) linear var(--draw-delay) forwards;
  }

  @keyframes brush-draw {
    to {
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
    }
  }
</style>
