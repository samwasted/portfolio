---
/**
 * EventLedger — System log style timeline component.
 */

interface Event {
  tag: string;
  date: string;
  description: string;
  highlight: boolean | "medium";
}

const events: Event[] = [
  { 
    tag: "BASE", 
    date: "2024-07", 
    description: "System initialization: Admitted to Indian Institute of Technology (IIT) BHU, Varanasi. Enrolled in Mathematics and Computing (IDD).", 
    highlight: false 
  },

  { 
    tag: "INDUCT", 
    date: "2025-06", 
    description: "Club of Programmers (COPS) selection following full-stack Next.js, Redis, and WebSocket application deployments.", 
    highlight: false 
  },

  { 
    tag: "AWARD", 
    date: "2025-12", 
    description: "Bronze Medal at Inter IIT Tech Meet 14.0 (Quant Problem Statement). Market models and backtesting pipeline architecture.", 
    highlight: true 
  },
  { 
    tag: "INDUCT", 
    date: "2026-01", 
    description: "Algorithmic Trading vertical selection at The Quant Club (TQC), IIT BHU.", 
    highlight: false 
  },
  { 
    tag: "RANK", 
    date: "2026-02", 
    description: "Codeforces Expert Rank profile validation via advanced data structures and algorithmic execution.", 
    highlight: "medium"
  },
  { 
    tag: "CORE", 
    date: "2026-04", 
    description: "\"jailsh\" C++17 interactive execution sandbox and container runtime. Engineered a strict double-fork PID 1 init model, IPC handshakes, and cgroups v2 boundaries.", 
    highlight: true 
  }
];
---

<div class="event-ledger">
  <div class="ledger-line"></div>
  
  <div class="ledger-events">
    {events.map(event => (
      <div class={`ledger-event ${event.highlight === true ? 'is-highlight' : event.highlight === 'medium' ? 'is-medium' : 'is-standard'}`}>
        <div class="ledger-node"></div>
        <div class="ledger-content">
          <span class="ledger-meta">
            <span class="ledger-tag">[{event.tag}]</span> 
            <span class="ledger-date">{event.date}</span>
            <span class="ledger-separator">|</span>
          </span>
          <span class="ledger-desc">{event.description}</span>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .event-ledger {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.6;
    max-width: 800px;
    margin: 4rem auto;
    padding: 4rem 0 2rem;
  }

  .ledger-line {
    position: absolute;
    top: 4rem;
    bottom: 2rem;
    left: 4px;
    width: 1px;
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.1) 10%, rgba(255, 255, 255, 0.1) 90%, transparent);
    z-index: 1;
  }

  .ledger-events {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
    z-index: 2;
  }

  .ledger-event {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    position: relative;
  }

  /* Node styling */
  .ledger-node {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    margin-top: 0.4rem;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .is-standard .ledger-node {
    background: #333;
    border: 1px solid #444;
  }
  
  .is-medium .ledger-node {
    background: rgba(255, 255, 255, 0.7);
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.3);
  }

  .is-highlight .ledger-node {
    background: #fff;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.8), 0 0 20px rgba(255, 255, 255, 0.4);
  }

  /* Content styling */
  .ledger-content {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  @media (min-width: 768px) {
    .ledger-content {
      flex-direction: row;
      gap: 0.75rem;
      align-items: flex-start;
    }
  }

  .ledger-meta {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .is-standard .ledger-meta {
    color: rgba(255, 255, 255, 0.4);
  }
  
  .is-medium .ledger-meta {
    color: rgba(255, 255, 255, 0.7);
  }

  .is-highlight .ledger-meta {
    color: rgba(255, 255, 255, 0.9);
  }

  .ledger-tag {
    font-weight: 600;
  }

  .ledger-separator {
    margin: 0 0.5rem;
    color: rgba(255, 255, 255, 0.2);
  }

  /* Description styling */
  .is-standard .ledger-desc {
    color: rgba(255, 255, 255, 0.4);
  }
  
  .is-medium .ledger-desc {
    color: rgba(255, 255, 255, 0.8);
  }

  .is-highlight .ledger-desc {
    color: #fff;
    font-weight: 500;
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.3);
  }

  /* Hover effect for all events to make them readable if needed */
  .ledger-event:hover .ledger-node {
    background: #fff;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
    border-color: #fff;
  }

  .ledger-event:hover .ledger-meta,
  .ledger-event:hover .ledger-desc {
    color: #fff;
  }
</style>
