---
/**
 * FujiShaderOverlay — Transparent WebGL canvas overlay
 * Renders the Mt Fuji watercolor shader over the existing background.
 * 
 * Performance strategy:
 *  1. Downscale canvas to 1/3 native resolution (matches main background)
 *  2. Cap framerate to 30fps during the reveal, 24fps after it (drifting mist)
 *  3. Skip frames while the hero is scrolled away or the tab is hidden
 *  4. Reduced motion: freeze on the finished painting
 */
---

<canvas id="fuji-shader-overlay" aria-hidden="true"></canvas>

<style>
  #fuji-shader-overlay {
    position: fixed;
    top: 1rem;
    left: 1rem;
    width: calc(100% - 2rem);
    height: calc(100% - 2rem);
    z-index: 10;
    pointer-events: none;
  }
</style>

<script>
  import { createShaderProgram, createFullscreenQuad, resizeCanvasToDisplaySize } from '../lib/webgl-utils';
  import vertSrc from '../shaders/background.vert?raw';
  import fragSrc from '../shaders/fuji.frag?raw';

  function initFujiShader() {
    const canvas = document.getElementById('fuji-shader-overlay') as HTMLCanvasElement;
    if (!canvas) return;

    // Prevent double-init
    if ((canvas as any).__fuji_init) return;
    (canvas as any).__fuji_init = true;

    const gl = canvas.getContext('webgl2', { alpha: true, antialias: false, premultipliedAlpha: false });
    if (!gl) return;

    const program = createShaderProgram(gl, vertSrc, fragSrc);
    if (!program) return;

    const quad = createFullscreenQuad(gl);
    if (!quad) return;

    const uTime = gl.getUniformLocation(program, 'uTime');
    const uResolution = gl.getUniformLocation(program, 'uResolution');

    gl.enable(gl.BLEND);
    gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);

    // Downscale to 1/3 native resolution
    const DOWNSCALE_FACTOR = 3;
    const dpr = window.devicePixelRatio / DOWNSCALE_FACTOR;
    let startTime = performance.now();
    let animId: number;
    let lastFrameTime = 0;
    let frozen = false;

    // The reveal completes around 4s; after that only the mist moves
    const FREEZE_AFTER_MS = 4000;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let resizeTimeout: number | null = null;
    function handleResize() {
      if (resizeTimeout !== null) clearTimeout(resizeTimeout);
      resizeTimeout = window.setTimeout(() => {
        resizeCanvasToDisplaySize(canvas, dpr);
        gl!.viewport(0, 0, canvas.width, canvas.height);
        // If frozen and resized, re-render one frame at the new size
        if (frozen) {
          renderFrame((performance.now() - startTime) / 1000.0);
        }
      }, 100);
    }

    window.addEventListener('resize', handleResize);
    handleResize();

    function renderFrame(time: number) {
      gl!.clearColor(0, 0, 0, 0);
      gl!.clear(gl!.COLOR_BUFFER_BIT);
      gl!.useProgram(program);
      gl!.uniform1f(uTime, time);
      gl!.uniform2f(uResolution, canvas.width, canvas.height);
      gl!.bindVertexArray(quad);
      gl!.drawArrays(gl!.TRIANGLES, 0, 6);
    }

    let accumulator = 0;
    const TIME_STEP = 1000 / 30; // ~33.33ms for 30fps during the reveal
    const MIST_STEP = 1000 / 24; // slower once only the mist drifts

    function render(now: number) {
      // If canvas removed from DOM (navigated away), stop entirely
      if (!document.body.contains(canvas)) {
        window.removeEventListener('resize', handleResize);
        return; // Do NOT schedule another frame
      }

      if (lastFrameTime === 0) lastFrameTime = now;
      const deltaTime = now - lastFrameTime;
      lastFrameTime = now;
      accumulator += deltaTime;

      const elapsed = now - startTime;

      // Reduced motion: render the finished painting once and stop
      if (reduceMotion && elapsed > FREEZE_AFTER_MS) {
        if (!frozen) {
          frozen = true;
          renderFrame(elapsed / 1000.0);
        }
        return;
      }

      // Nothing to see while the About section covers the hero or the tab is hidden
      const onScreen = !document.hidden && window.scrollY < window.innerHeight;
      const step = elapsed > FREEZE_AFTER_MS ? MIST_STEP : TIME_STEP;

      if (onScreen && accumulator >= step) {
        accumulator = accumulator % step;
        renderFrame(elapsed / 1000.0);
      }

      animId = requestAnimationFrame(render);
    }

    animId = requestAnimationFrame(render);
  }

  // Init directly when component mounts
  initFujiShader();
  document.addEventListener('astro:after-swap', () => {
    const canvas = document.getElementById('fuji-shader-overlay') as HTMLCanvasElement;
    if (canvas && !(canvas as any).__fuji_init) {
      initFujiShader();
    }
  });
</script>

