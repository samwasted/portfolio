---
import BaseLayout from './BaseLayout.astro';
import ShaderBackground from '../components/ShaderBackground.astro';
import Nav from '../components/Nav.astro';

import '../styles/editorial.css';
import '../styles/katex-overrides.css';
import '../styles/pandoc-highlight.css';

export interface Props {
  title: string;
  author?: string;
  date?: string;
  abstract?: string;
  layout_type?: string;
}

const { title, author, date, abstract, layout_type = 'single' } = Astro.props;
---

<BaseLayout title={`${title} - Samarpan Verma`} description={abstract || `Editorial: ${title}`}>
  <ShaderBackground />

  <div class="editorial-page">
    <Nav active="editorials" showBack={true} backUrl="/editorials" backText="Go Back" hideLinks={true} />

    <article class={`editorial-container layout-${layout_type}`}>
      <header class="editorial-header">
        <h1>{title}</h1>
        {layout_type === 'ieee' && (
          <div class="ieee-mobile-warning">
            * IEEE style document. Rotate device for better view.
          </div>
        )}
        {author && <p class="author">{author}</p>}
        {date && <p class="date">{date}</p>}
      </header>

      {abstract && (
        <div class="editorial-abstract">
          <strong>Abstract - </strong>{abstract}
        </div>
      )}

      <div class="editorial-body">
        <slot />
      </div>
    </article>
  </div>

  <style>
    .editorial-page {
      position: fixed;
      inset: 1rem;
      overflow-y: auto;
      z-index: 1;
      padding-top: 4rem; /* Ensure space for the global nav */
      scrollbar-width: thin;
    }

    @media (max-width: 900px) and (orientation: portrait) {
      .editorial-page {
        inset: 0.5rem; /* Match the new 0.5rem mobile border mask */
      }
    }
  </style>

  <style is:global>
    /* Cinematic Fade-in to completely eliminate layout shift/flinching */
    .editorial-body {
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1), transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .editorial-body.content-ready {
      opacity: 1;
      transform: translateY(0);
    }
    /* Hide raw mermaid code before rendering */
    .mermaid:not([data-processed="true"]) {
      visibility: hidden;
      height: 0;
      margin: 0;
    }
  </style>

  <script>
    function setupCopyButtons() {
      document.querySelectorAll<HTMLElement>('.editorial-body pre:not([data-copy-added])').forEach(pre => {
        pre.setAttribute('data-copy-added', 'true');
        const btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.innerText = 'Copy';
        
        btn.addEventListener('click', async () => {
          const code = pre.querySelector('code')?.innerText || pre.innerText;
          try {
            await navigator.clipboard.writeText(code);
            btn.innerText = 'Copied!';
            setTimeout(() => { btn.innerText = 'Copy'; }, 2000);
          } catch (err) {
            console.error('Failed to copy', err);
          }
        });
        
        pre.appendChild(btn);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupCopyButtons);
    } else {
      setupCopyButtons();
    }
    
    document.addEventListener('astro:after-swap', setupCopyButtons);
  </script>

  <script type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
    mermaid.initialize({ startOnLoad: false, theme: 'dark' });
    
    async function renderMermaid() {
      const body = document.querySelector('.editorial-body');
      const nodes = document.querySelectorAll('.mermaid');
      
      if (nodes.length > 0) {
        try {
          await mermaid.run({ nodes });
        } catch (err) {
          console.warn('[Mermaid Error]', err);
        }
      }
      
      // Reveal the content gracefully after DOM has settled
      if (body) {
        requestAnimationFrame(() => {
          body.classList.add('content-ready');
        });
      }
    }
    
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', renderMermaid);
    } else {
      renderMermaid();
    }
    
    document.addEventListener('astro:after-swap', renderMermaid);
  </script>
</BaseLayout>
