---
import BaseLayout from './BaseLayout.astro';
import ShaderBackground from '../components/ShaderBackground.astro';
import Nav from '../components/Nav.astro';

import '../styles/editorial.css';
import '../styles/katex-overrides.css';
import '../styles/pandoc-highlight.css';

export interface Props {
  title: string;
  author?: string;
  date?: string;
  abstract?: string;
  layout_type?: string;
}

const { title, author, date, abstract, layout_type = 'single' } = Astro.props;
---

<BaseLayout title={`${title} - Samarpan Verma`} description={abstract || `Editorial: ${title}`}>
  <ShaderBackground />

  <div class="editorial-page">
    <Nav active="editorials" showBack={true} backUrl="/editorials" />

    <article class={`editorial-container layout-${layout_type}`}>
      <header class="editorial-header">
        <h1>{title}</h1>
        {author && <p class="author">{author}</p>}
        {date && <p class="date">{date}</p>}
      </header>

      {abstract && (
        <div class="editorial-abstract">
          <strong>Abstract - </strong>{abstract}
        </div>
      )}

      <div class="editorial-body">
        <slot />
      </div>
    </article>
  </div>

  <style>
    .editorial-page {
      position: relative;
      z-index: 1;
      padding-top: 4rem; /* Ensure space for the global nav */
    }
    .editorial-body {
      opacity: 0;
      transition: opacity 0.15s ease-in;
    }
    .editorial-body.ready {
      opacity: 1;
    }
  </style>

  <!-- KaTeX auto-render: processes .math.inline and .math.display spans -->
  <script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js" crossorigin="anonymous" is:inline></script>
  <script>
    function renderEditorialFeatures() {
      // --- Render Math ---
      // @ts-ignore
      const katex = window.katex;
      if (typeof katex === 'undefined') {
        setTimeout(renderEditorialFeatures, 50); // wait for script to load
        return;
      }
      
      // Render inline math
      document.querySelectorAll<HTMLElement>('.math.inline:not([data-rendered])').forEach(el => {
        try {
          katex.render(el.textContent || '', el, { throwOnError: false, displayMode: false });
          el.setAttribute('data-rendered', 'true');
        } catch (e) { console.warn('KaTeX inline error:', e); }
      });
      // Render display math
      document.querySelectorAll<HTMLElement>('.math.display:not([data-rendered])').forEach(el => {
        try {
          katex.render(el.textContent || '', el, { throwOnError: false, displayMode: true });
          el.setAttribute('data-rendered', 'true');
        } catch (e) { console.warn('KaTeX display error:', e); }
      });

      // --- Setup Copy Buttons ---
      document.querySelectorAll<HTMLElement>('.editorial-body pre:not([data-copy-added])').forEach(pre => {
        pre.setAttribute('data-copy-added', 'true');
        const btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.innerText = 'Copy';
        
        btn.addEventListener('click', async () => {
          const code = pre.querySelector('code')?.innerText || pre.innerText;
          try {
            await navigator.clipboard.writeText(code);
            btn.innerText = 'Copied!';
            setTimeout(() => { btn.innerText = 'Copy'; }, 2000);
          } catch (err) {
            console.error('Failed to copy', err);
          }
        });
        
        pre.appendChild(btn);
      });

      // Show the content now that everything is safely rendered
      document.querySelector('.editorial-body')?.classList.add('ready');
    }

    // Run on initial load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', renderEditorialFeatures);
    } else {
      renderEditorialFeatures();
    }
    
    // Run BEFORE the new page is painted during View Transitions to prevent flinch
    document.addEventListener('astro:after-swap', renderEditorialFeatures);
  </script>
</BaseLayout>
